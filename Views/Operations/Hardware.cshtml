@model Kawin_67091861_002.ViewModels.HardwarePageViewModel
@{
    ViewData["Title"] = "รายการอุปกรณ์และทรัพย์สิน";
    Layout = "_LayoutOperations";
}

<!-- Flash Notification -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show custom-toast-ops mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header Bar -->
<div class="hw-header-bar">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="hw-main-title">รายการอุปกรณ์และทรัพย์สิน</h1>
            <span class="live-status-pill">
                <span class="pulse-dot"></span> LIVE
            </span>
        </div>
        <p class="hw-subtitle">
            ฐานระบบตรวจสอบ รายการทรัพย์สินและประวัติบำรุงรักษา เครื่องฉาย ระบบเสียง และแอร์ทุกโรงหนัง
        </p>
    </div>

    <!-- Right Header Action -->
    <button type="button" class="btn-new-hw" data-bs-toggle="modal" data-bs-target="#createHwModal">
        <i class="bi bi-plus-circle me-1"></i> ลงทะเบียนอุปกรณ์ใหม่
    </button>
</div>

<!-- 3 Top Summary KPI Cards -->
<div class="hw-kpi-grid mt-4">
    <!-- Card 1: อุปกรณ์ทั้งหมด -->
    <div class="hw-kpi-card">
        <div class="kpi-top-row">
            <span class="kpi-label">อุปกรณ์ทั้งหมด</span>
            <div class="kpi-icon-box green">
                <i class="bi bi-display"></i>
            </div>
        </div>
        <div class="kpi-stat-value">@Model.TotalAssetsCount เครื่อง</div>
        <div class="kpi-stat-sub teal">@Model.TotalAssetsSubtext</div>
    </div>

    <!-- Card 2: อัตราออนไลน์สแตนด์บาย -->
    <div class="hw-kpi-card">
        <div class="kpi-top-row">
            <span class="kpi-label">อัตราออนไลน์สแตนด์บาย</span>
            <div class="kpi-icon-box green">
                <i class="bi bi-shield-check"></i>
            </div>
        </div>
        <div class="kpi-stat-value">@Model.OnlineStandbyRate</div>
        <div class="kpi-stat-sub teal">@Model.OnlineStandbySubtext</div>
    </div>

    <!-- Card 3: ครบกำหนดซ่อมบำรุง -->
    <div class="hw-kpi-card">
        <div class="kpi-top-row">
            <span class="kpi-label">ครบกำหนดซ่อมบำรุง</span>
            <div class="kpi-icon-box amber">
                <i class="bi bi-wrench"></i>
            </div>
        </div>
        <div class="kpi-stat-value">@Model.DueForMaintenanceCount ชิ้น</div>
        <div class="kpi-stat-sub amber">@Model.DueForMaintenanceSubtext</div>
    </div>
</div>

<!-- Table Panel: ฐานระบบอุปกรณ์ทั้งหมดในสาขานี้ -->
<div class="hw-table-panel mt-4">
    <div class="hw-table-header">
        <h2 class="panel-card-title">ฐานระบบอุปกรณ์ทั้งหมดในสาขานี้</h2>
    </div>

    <div class="table-responsive mt-3">
        <table class="table hw-custom-table align-middle">
            <thead>
                <tr>
                    <th style="width: 28%;">ชื่ออุปกรณ์ / โมเดลผู้ผลิต</th>
                    <th style="width: 16%;">ประเภทอุปกรณ์</th>
                    <th style="width: 14%;">โรงติดตั้ง</th>
                    <th style="width: 14%;">สถานะใช้งาน</th>
                    <th style="width: 14%;">วันติดตั้ง</th>
                    <th style="width: 14%; text-align: right;">บำรุงรักษาครั้งต่อไป</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Assets.Any())
                {
                    @foreach (var item in Model.Assets)
                    {
                        <tr>
                            <td>
                                <span class="hw-title-text">@item.NameAndModel</span>
                            </td>
                            <td class="text-white-75">
                                @item.Category
                            </td>
                            <td class="text-white-75">
                                @item.CinemaHall
                            </td>
                            <td>
                                @if (item.Status == "ปกติ")
                                {
                                    <span class="status-dot-pill green">
                                        <span class="dot"></span> ปกติ
                                    </span>
                                }
                                else if (item.Status.Contains("ซ่อมบำรุง"))
                                {
                                    <span class="status-dot-pill amber">
                                        <span class="dot"></span> ต้องซ่อมบำรุง
                                    </span>
                                }
                                else
                                {
                                    <span class="status-dot-pill red">
                                        <span class="dot"></span> ออฟไลน์
                                    </span>
                                }
                            </td>
                            <td class="text-muted small">
                                @item.InstalledDate
                            </td>
                            <td style="text-align: right;">
                                @if (item.IsUrgentMaintenance)
                                {
                                    <span class="fw-bold text-danger">@item.NextMaintenanceDate</span>
                                }
                                else
                                {
                                    <span class="text-muted small">@item.NextMaintenanceDate</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-cpu fs-2 d-block mb-2 text-secondary"></i>
                            ไม่พบรายการอุปกรณ์ในระบบ
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: ลงทะเบียนอุปกรณ์ใหม่ -->
<div class="modal fade" id="createHwModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ops-modal-box">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold">
                    <i class="bi bi-plus-circle text-emerald me-2"></i> ลงทะเบียนอุปกรณ์ใหม่
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateHardwareAsset" method="post">
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label text-muted small">ชื่ออุปกรณ์และโมเดลผู้ผลิต</label>
                        <input type="text" name="NameAndModel" class="form-control ops-input" 
                               placeholder="เช่น Laser Projector 4K - Christie, Dolby Cinema Processor" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small">ประเภทอุปกรณ์</label>
                            <select name="Category" class="form-select ops-input">
                                <option value="ระบบฉายภาพ" selected>ระบบฉายภาพ (Projector)</option>
                                <option value="ระบบเสียง">ระบบเสียง (Audio System)</option>
                                <option value="เซิร์ฟเวอร์">เซิร์ฟเวอร์ (Media Server)</option>
                                <option value="ระบบปรับอากาศ">ระบบปรับอากาศ (HVAC)</option>
                                <option value="ระบบจ่ายไฟฟ้า">ระบบจ่ายไฟฟ้า (Power/UPS)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small">โรงภาพยนตร์ / ตำแหน่งติดตั้ง</label>
                            <select name="CinemaHall" class="form-select ops-input">
                                <option value="โรง 1">โรง 1 (IMAX)</option>
                                <option value="โรง 2">โรง 2 (Dolby Atmos)</option>
                                <option value="โรง 3">โรง 3 (Digital 4K)</option>
                                <option value="โรง 4">โรง 4 (Standard)</option>
                                <option value="ห้องเซิร์ฟเวอร์หลัก">ห้องเซิร์ฟเวอร์หลัก</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label text-muted small">สถานะเริ่มต้น</label>
                        <select name="Status" class="form-select ops-input">
                            <option value="ปกติ" selected>ปกติ (Online Standby)</option>
                            <option value="ต้องซ่อมบำรุง">ต้องซ่อมบำรุง (Maintenance Required)</option>
                            <option value="ออฟไลน์">ออฟไลน์ (Offline)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-emerald btn-sm px-4 fw-bold">ลงทะเบียนอุปกรณ์</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .hw-header-bar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .hw-main-title {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
        letter-spacing: -0.3px;
    }

    .hw-subtitle {
        color: #64748b;
        font-size: 13.5px;
        margin: 0;
    }

    .live-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.4);
        color: #10b981;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 9px;
        border-radius: 12px;
        letter-spacing: 0.5px;
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 6px #10b981;
    }

    .btn-new-hw {
        background: #10b981;
        color: #032015;
        border: none;
        font-weight: 700;
        font-size: 13.5px;
        padding: 9px 18px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
        box-shadow: 0 2px 10px rgba(16, 185, 129, 0.25);
    }

    .btn-new-hw:hover {
        background: #34d399;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
    }

    /* 3 KPI Cards */
    .hw-kpi-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .hw-kpi-card {
        background: #0f1613;
        border: 1px solid #192721;
        border-radius: 14px;
        padding: 20px 22px;
    }

    .kpi-top-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .kpi-label {
        font-size: 12.5px;
        color: #64748b;
        font-weight: 500;
    }

    .kpi-icon-box {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .kpi-icon-box.green {
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .kpi-icon-box.amber {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .kpi-stat-value {
        font-size: 32px;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.1;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }

    .kpi-stat-sub {
        font-size: 12px;
        font-weight: 500;
    }
    .kpi-stat-sub.teal { color: #14b8a6; }
    .kpi-stat-sub.amber { color: #fbbf24; }

    /* Table Panel */
    .hw-table-panel {
        background: #0f1613;
        border: 1px solid #192721;
        border-radius: 14px;
        padding: 20px 22px;
    }

    .panel-card-title {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .hw-custom-table {
        margin: 0;
        border-collapse: separate;
        border-spacing: 0 4px;
    }

    .hw-custom-table thead th {
        background: transparent;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        border: none;
        padding: 10px 14px;
    }

    .hw-custom-table tbody tr {
        background: #121c17;
        border-radius: 8px;
        transition: all 0.15s ease;
    }

    .hw-custom-table tbody tr:hover {
        background: #16241e;
    }

    .hw-custom-table td {
        padding: 14px 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        background: transparent;
    }

    .hw-custom-table td:first-child {
        border-left: 1px solid rgba(255, 255, 255, 0.03);
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
    }

    .hw-custom-table td:last-child {
        border-right: 1px solid rgba(255, 255, 255, 0.03);
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    .hw-title-text {
        font-weight: 600;
        color: #ffffff;
        font-size: 13.5px;
    }

    /* Status Dot Pill */
    .status-dot-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12.5px;
        font-weight: 500;
    }

    .status-dot-pill .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .status-dot-pill.green { color: #34d399; }
    .status-dot-pill.green .dot { background: #10b981; box-shadow: 0 0 6px #10b981; }

    .status-dot-pill.amber { color: #fbbf24; }
    .status-dot-pill.amber .dot { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; }

    .status-dot-pill.red { color: #f87171; }
    .status-dot-pill.red .dot { background: #ef4444; box-shadow: 0 0 6px #ef4444; }

    .ops-modal-box {
        background: #0f1714;
        border: 1px solid #1c2e26;
        border-radius: 14px;
    }

    .ops-input {
        background: #14201b;
        border: 1px solid #20352c;
        color: #ffffff;
        border-radius: 8px;
    }

    .ops-input:focus {
        background: #16241e;
        border-color: #10b981;
        color: #ffffff;
        box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
    }

    .btn-emerald {
        background: #10b981;
        color: #042417;
    }

    .btn-emerald:hover {
        background: #34d399;
    }

    .custom-toast-ops {
        background: #0d281e;
        border: 1px solid #10b981;
        color: #ffffff;
        border-radius: 10px;
    }

    @@media (max-width: 992px) {
        .hw-kpi-grid { grid-template-columns: 1fr; }
    }
</style>
