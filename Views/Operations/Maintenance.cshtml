@model Kawin_67091861_002.ViewModels.MaintenancePageViewModel
@{
    ViewData["Title"] = "ตารางงานบำรุงรักษา";
    Layout = "_LayoutOperations";
}

<!-- Flash Notification -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show custom-toast-ops mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Header Bar -->
<div class="maint-header-bar">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="maint-main-title">ตารางงานบำรุงรักษา</h1>
            <span class="live-status-pill">
                <span class="pulse-dot"></span> LIVE
            </span>
        </div>
        <p class="maint-subtitle">
            วางแผนจัดรอบ และติดตามการบำรุงรักษาเชิงป้องกันเพื่อหลีกเลี่ยงความเสียหายของอุปกรณ์ฉายภาพและเสียง
        </p>
    </div>

    <!-- Right Header Action -->
    <button type="button" class="btn-new-maint" data-bs-toggle="modal" data-bs-target="#createMaintModal">
        <i class="bi bi-plus-circle me-1"></i> สร้างงานบำรุงรักษาใหม่
    </button>
</div>

<!-- 3 Top Summary KPI Cards -->
<div class="maint-kpi-grid mt-4">
    <!-- Card 1: งานคงค้างวันนี้ -->
    <div class="maint-kpi-card">
        <div class="kpi-top-row">
            <span class="kpi-label">งานคงค้างวันนี้</span>
            <div class="kpi-icon-box amber">
                <i class="bi bi-exclamation-circle"></i>
            </div>
        </div>
        <div class="kpi-stat-value">@Model.PendingCountToday งาน</div>
        <div class="kpi-stat-sub red">@Model.PendingSubtext</div>
    </div>

    <!-- Card 2: เสร็จตามกำหนด -->
    <div class="maint-kpi-card">
        <div class="kpi-top-row">
            <span class="kpi-label">เสร็จตามกำหนด</span>
            <div class="kpi-icon-box green">
                <i class="bi bi-shield-check"></i>
            </div>
        </div>
        <div class="kpi-stat-value">@Model.CompletedOnTimePercent</div>
        <div class="kpi-stat-sub teal">@Model.CompletedOnTimeSubtext</div>
    </div>

    <!-- Card 3: งานบำรุงรักษาเฉลี่ยล่าช้า -->
    <div class="maint-kpi-card">
        <div class="kpi-top-row">
            <span class="kpi-label">งานบำรุงรักษาเฉลี่ยล่าช้า</span>
            <div class="kpi-icon-box teal">
                <i class="bi bi-clock"></i>
            </div>
        </div>
        <div class="kpi-stat-value">@Model.AvgDelayMinutes</div>
        <div class="kpi-stat-sub teal">@Model.AvgDelaySubtext</div>
    </div>
</div>

<!-- Week Calendar Day Picker -->
<div class="calendar-week-row mt-4">
    @{
        var days = new[]
        {
            (day: 14, label: "จ.", num: "14"),
            (day: 15, label: "อ.", num: "15"),
            (day: 16, label: "พ.", num: "16"),
            (day: 17, label: "พฤ.", num: "17"),
            (day: 18, label: "ศ.", num: "18"),
            (day: 19, label: "ส.", num: "19"),
            (day: 20, label: "อา.", num: "20")
        };
    }
    @foreach (var d in days)
    {
        bool isSel = d.day == Model.SelectedDay;
        <a asp-action="Maintenance" asp-route-day="@d.day" 
           class="calendar-day-box @(isSel ? "active" : "")">
            <span class="cal-day-label">@d.label</span>
            <span class="cal-day-number">@d.num</span>
        </a>
    }
</div>

<!-- Table: รายการงานบำรุงรักษา -->
<div class="maint-table-panel mt-3">
    <div class="table-responsive">
        <table class="table maint-custom-table align-middle">
            <thead>
                <tr>
                    <th style="width: 38%;">รายการงานบำรุงรักษา</th>
                    <th style="width: 14%;">ประเภทงาน</th>
                    <th style="width: 20%;">ผู้รับผิดชอบ</th>
                    <th style="width: 14%;">กำหนดเสร็จ</th>
                    <th style="width: 14%; text-align: right;">สถานะงาน</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Tasks.Any())
                {
                    @foreach (var item in Model.Tasks)
                    {
                        <tr>
                            <td>
                                <span class="maint-title-text">@item.Title</span>
                            </td>
                            <td>
                                <span class="maint-cat-badge @item.CategoryColor">
                                    @item.Category
                                </span>
                            </td>
                            <td class="text-white-75">
                                @item.Assignee
                            </td>
                            <td class="text-muted small">
                                @item.ScheduleText
                            </td>
                            <td style="text-align: right;">
                                <span class="status-dot-pill @item.StatusDotColor">
                                    <span class="dot"></span> @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-check fs-2 d-block mb-2 text-secondary"></i>
                            ไม่มีงานบำรุงรักษาในวันที่เลือก
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: สร้างงานบำรุงรักษาใหม่ -->
<div class="modal fade" id="createMaintModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ops-modal-box">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold">
                    <i class="bi bi-plus-circle text-emerald me-2"></i> สร้างงานบำรุงรักษาใหม่
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateMaintenanceTask" method="post">
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label text-muted small">รายการงานบำรุงรักษา</label>
                        <input type="text" name="Title" class="form-control ops-input" 
                               placeholder="เช่น เปลี่ยนหลอดไฟโปรเจกเตอร์ โรง 4, ล้างฟิลเตอร์แอร์" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small">ประเภทงาน</label>
                            <select name="Category" class="form-select ops-input">
                                <option value="ตามแผน" selected>ตามแผน (Routine)</option>
                                <option value="แก้ไขทันที">แก้ไขทันที (Immediate)</option>
                                <option value="ฉุกเฉิน">ฉุกเฉิน (Emergency)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small">โรงภาพยนตร์ / จุดติดตั้ง</label>
                            <select name="CinemaHall" class="form-select ops-input">
                                <option value="โรง 1 (IMAX)">โรง 1 (IMAX)</option>
                                <option value="โรง 2 (Dolby Atmos)">โรง 2 (Dolby Atmos)</option>
                                <option value="โรง 3 (Digital 4K)">โรง 3 (Digital 4K)</option>
                                <option value="โรง 4 (Standard)" selected>โรง 4 (Standard)</option>
                                <option value="ตู้เมนสวิตช์ไฟฟ้า">ตู้เมนสวิตช์ไฟฟ้า</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label text-muted small">ผู้รับผิดชอบ</label>
                            <input type="text" name="Assignee" class="form-control ops-input" value="อนุชา • ช่างเทคนิค" />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small">กำหนดเวลาเสร็จ</label>
                            <input type="text" name="ScheduleTime" class="form-control ops-input" value="วันนี้ • 14:00 น." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-emerald btn-sm px-4 fw-bold">บันทึกงานบำรุงรักษา</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .maint-header-bar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .maint-main-title {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
        letter-spacing: -0.3px;
    }

    .maint-subtitle {
        color: #64748b;
        font-size: 13.5px;
        margin: 0;
    }

    .live-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.4);
        color: #10b981;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 9px;
        border-radius: 12px;
        letter-spacing: 0.5px;
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 6px #10b981;
    }

    .btn-new-maint {
        background: #10b981;
        color: #032015;
        border: none;
        font-weight: 700;
        font-size: 13.5px;
        padding: 9px 18px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        transition: all 0.2s ease;
        box-shadow: 0 2px 10px rgba(16, 185, 129, 0.25);
    }

    .btn-new-maint:hover {
        background: #34d399;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
    }

    /* 3 KPI Cards */
    .maint-kpi-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }

    .maint-kpi-card {
        background: #0f1613;
        border: 1px solid #192721;
        border-radius: 14px;
        padding: 20px 22px;
    }

    .kpi-top-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .kpi-label {
        font-size: 12.5px;
        color: #64748b;
        font-weight: 500;
    }

    .kpi-icon-box {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .kpi-icon-box.amber {
        background: rgba(245, 158, 11, 0.15);
        color: #f59e0b;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .kpi-icon-box.green {
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .kpi-icon-box.teal {
        background: rgba(20, 184, 166, 0.15);
        color: #14b8a6;
        border: 1px solid rgba(20, 184, 166, 0.3);
    }

    .kpi-stat-value {
        font-size: 32px;
        font-weight: 800;
        color: #ffffff;
        line-height: 1.1;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }

    .kpi-stat-sub {
        font-size: 12px;
        font-weight: 500;
    }
    .kpi-stat-sub.red { color: #f87171; }
    .kpi-stat-sub.teal { color: #14b8a6; }

    /* Calendar Day Picker */
    .calendar-week-row {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 12px;
    }

    .calendar-day-box {
        background: #0f1613;
        border: 1px solid #192721;
        border-radius: 12px;
        padding: 12px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .calendar-day-box:hover {
        background: #14211a;
        border-color: #24382d;
    }

    .calendar-day-box.active {
        background: #11261d;
        border: 1px solid #10b981;
    }

    .cal-day-label {
        font-size: 11px;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .calendar-day-box.active .cal-day-label {
        color: #10b981;
    }

    .cal-day-number {
        font-size: 18px;
        font-weight: 700;
        color: #ffffff;
    }

    /* Table Panel */
    .maint-table-panel {
        background: #0f1613;
        border: 1px solid #192721;
        border-radius: 14px;
        padding: 16px 20px;
    }

    .maint-custom-table {
        margin: 0;
        border-collapse: separate;
        border-spacing: 0 4px;
    }

    .maint-custom-table thead th {
        background: transparent;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        border: none;
        padding: 10px 14px;
    }

    .maint-custom-table tbody tr {
        background: #121c17;
        border-radius: 8px;
        transition: all 0.15s ease;
    }

    .maint-custom-table tbody tr:hover {
        background: #16241e;
    }

    .maint-custom-table td {
        padding: 14px 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        background: transparent;
    }

    .maint-custom-table td:first-child {
        border-left: 1px solid rgba(255, 255, 255, 0.03);
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
    }

    .maint-custom-table td:last-child {
        border-right: 1px solid rgba(255, 255, 255, 0.03);
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
    }

    .maint-title-text {
        font-weight: 600;
        color: #ffffff;
        font-size: 13.5px;
    }

    /* Category Badges */
    .maint-cat-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .maint-cat-badge.blue {
        background: rgba(14, 165, 233, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(14, 165, 233, 0.3);
    }

    .maint-cat-badge.amber {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .maint-cat-badge.red {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    /* Status Dot Pill */
    .status-dot-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12.5px;
        font-weight: 500;
    }

    .status-dot-pill .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .status-dot-pill.amber { color: #fbbf24; }
    .status-dot-pill.amber .dot { background: #f59e0b; box-shadow: 0 0 6px #f59e0b; }

    .status-dot-pill.grey { color: #94a3b8; }
    .status-dot-pill.grey .dot { background: #64748b; }

    .status-dot-pill.green { color: #34d399; }
    .status-dot-pill.green .dot { background: #10b981; box-shadow: 0 0 6px #10b981; }

    .status-dot-pill.red { color: #f87171; }
    .status-dot-pill.red .dot { background: #ef4444; box-shadow: 0 0 6px #ef4444; }

    .status-dot-pill.teal { color: #2dd4bf; }
    .status-dot-pill.teal .dot { background: #14b8a6; box-shadow: 0 0 6px #14b8a6; }

    .ops-modal-box {
        background: #0f1714;
        border: 1px solid #1c2e26;
        border-radius: 14px;
    }

    .ops-input {
        background: #14201b;
        border: 1px solid #20352c;
        color: #ffffff;
        border-radius: 8px;
    }

    .ops-input:focus {
        background: #16241e;
        border-color: #10b981;
        color: #ffffff;
        box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
    }

    .btn-emerald {
        background: #10b981;
        color: #042417;
    }

    .btn-emerald:hover {
        background: #34d399;
    }

    .custom-toast-ops {
        background: #0d281e;
        border: 1px solid #10b981;
        color: #ffffff;
        border-radius: 10px;
    }

    @@media (max-width: 992px) {
        .maint-kpi-grid { grid-template-columns: 1fr; }
        .calendar-week-row { overflow-x: auto; display: flex; }
        .calendar-day-box { min-width: 65px; }
    }
</style>
