@model Kawin_67091861_002.ViewModels.TechChatPageViewModel
@{
    ViewData["Title"] = "แชตและศูนย์ติดต่อสื่อสารภายในทีม";
    Layout = "_LayoutOperations";
}

<!-- Page Header Bar -->
<div class="chat-header-bar">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="chat-main-title">แชตและศูนย์ติดต่อสื่อสารภายในทีม</h1>
            <span class="live-status-pill">
                <span class="pulse-dot"></span> LIVE
            </span>
        </div>
        <p class="chat-subtitle">
            ประสานงานกับทีมงาน บันทึกอาการและประสานงานแก้ไขปัญหาแบบทันที
        </p>
    </div>
</div>

<!-- Chat 2-Column Grid -->
<div class="chat-layout-grid mt-4">
    <!-- Left Column: ห้องสนทนาทั้งหมด -->
    <div class="chat-rooms-panel">
        <h2 class="rooms-panel-title">ห้องสนทนาทั้งหมด</h2>

        <div class="rooms-list-group mt-3">
            @foreach (var room in Model.Rooms)
            {
                <a asp-action="TechChat" asp-route-channel="@room.Id" 
                   class="room-item-link @(room.IsActive ? "active" : "")">
                    <div class="room-avatar-green">
                        <i class="bi bi-chat-square-text-fill"></i>
                    </div>

                    <div class="room-item-info">
                        <div class="room-title-row">
                            <span class="room-title-text">@room.Name</span>
                            <span class="room-time-text">@room.LastMessageTime</span>
                        </div>
                        <div class="room-preview-row">
                            <span class="room-preview-text text-truncate">@room.LastMessageText</span>
                            @if (room.UnreadCount > 0)
                            {
                                <span class="room-unread-badge">@room.UnreadCount</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>

    <!-- Right Column: Chat Window -->
    <div class="chat-window-panel">
        <!-- Room Header -->
        <div class="chat-window-header">
            <div class="cwh-avatar-green">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h3 class="cwh-room-title">@Model.ActiveRoom.Name</h3>
                <span class="cwh-status-sub">@Model.ActiveRoom.OnlineStatusText</span>
            </div>
        </div>

        <!-- Messages Stream -->
        <div class="chat-messages-stream" id="messagesContainer">
            @if (Model.Messages.Any())
            {
                @foreach (var msg in Model.Messages)
                {
                    if (msg.IsMine)
                    {
                        <!-- Outgoing Message (Right / Green) -->
                        <div class="chat-msg-row outgoing">
                            <div class="msg-meta-info text-end">
                                <span class="msg-sender-name">@msg.SenderName</span>
                            </div>
                            <div class="msg-bubble outgoing">
                                @msg.MessageText
                            </div>
                            <div class="msg-time-info text-end">
                                @msg.TimeText
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Incoming Message (Left / Dark) -->
                        <div class="chat-msg-row incoming">
                            <div class="msg-meta-info">
                                <span class="msg-sender-name">@msg.SenderName</span>
                            </div>
                            <div class="msg-bubble incoming">
                                @msg.MessageText
                            </div>
                            <div class="msg-time-info">
                                @msg.TimeText
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-dots fs-1 d-block mb-2 text-secondary"></i>
                    ยังไม่มีข้อความในห้องนี้ เริ่มต้นพิมพ์ข้อความเพื่อพูดคุยประสานงานได้เลย
                </div>
            }
        </div>

        <!-- Chat Input Footer Form -->
        <div class="chat-input-footer">
            <form asp-action="SendTechChatMessage" method="post" class="chat-send-form">
                <input type="hidden" name="channelId" value="@Model.ActiveRoomId" />
                <input type="text" name="messageText" class="form-control chat-custom-input" 
                       placeholder="พิมพ์ข้อความประสานงานทางเทคนิค..." autocomplete="off" required />
                <button type="submit" class="btn-chat-send">
                    ส่งข้อความ
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    // Auto scroll chat to bottom
    window.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('messagesContainer');
        if (container) {
            container.scrollTop = container.scrollHeight;
        }
    });
</script>

<style>
    .chat-header-bar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .chat-main-title {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
        letter-spacing: -0.3px;
    }

    .chat-subtitle {
        color: #64748b;
        font-size: 13.5px;
        margin: 0;
    }

    .live-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.4);
        color: #10b981;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 9px;
        border-radius: 12px;
        letter-spacing: 0.5px;
    }

    .pulse-dot {
        width: 6px;
        height: 6px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 6px #10b981;
    }

    /* 2-Column Grid */
    .chat-layout-grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 20px;
        height: calc(100vh - 190px);
        min-height: 580px;
    }

    /* Left Rooms Panel */
    .chat-rooms-panel {
        background: #0f1613;
        border: 1px solid #192721;
        border-radius: 14px;
        padding: 20px 18px;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
    }

    .rooms-panel-title {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .rooms-list-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .room-item-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: #121c17;
        border: 1px solid rgba(255, 255, 255, 0.02);
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .room-item-link:hover {
        background: #17241e;
        border-color: #24382d;
    }

    .room-item-link.active {
        background: #152720;
        border: 1px solid #10b981;
    }

    .room-avatar-green {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .room-item-link.active .room-avatar-green {
        background: #10b981;
        color: #032015;
    }

    .room-item-info {
        flex: 1;
        min-width: 0;
    }

    .room-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2px;
    }

    .room-title-text {
        font-size: 13.5px;
        font-weight: 600;
        color: #ffffff;
    }

    .room-time-text {
        font-size: 11px;
        color: #64748b;
    }

    .room-preview-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .room-preview-text {
        font-size: 11.5px;
        color: #8fa0b5;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .room-unread-badge {
        background: #e50914;
        color: #ffffff;
        font-size: 10.5px;
        font-weight: 700;
        padding: 1px 7px;
        border-radius: 10px;
        flex-shrink: 0;
    }

    /* Right Chat Window */
    .chat-window-panel {
        background: #0f1613;
        border: 1px solid #192721;
        border-radius: 14px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .chat-window-header {
        padding: 16px 22px;
        background: #111a17;
        border-bottom: 1px solid #1a2c26;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .cwh-avatar-green {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border: 1px solid rgba(16, 185, 129, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .cwh-room-title {
        font-size: 15px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .cwh-status-sub {
        font-size: 11.5px;
        color: #10b981;
    }

    /* Messages Stream */
    .chat-messages-stream {
        flex: 1;
        padding: 22px 24px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .chat-msg-row {
        display: flex;
        flex-direction: column;
        max-width: 72%;
    }

    .chat-msg-row.incoming {
        align-self: flex-start;
    }

    .chat-msg-row.outgoing {
        align-self: flex-end;
    }

    .msg-meta-info {
        margin-bottom: 4px;
    }

    .msg-sender-name {
        font-size: 11.5px;
        font-weight: 600;
        color: #64748b;
    }

    .msg-bubble {
        padding: 12px 16px;
        font-size: 13px;
        line-height: 1.45;
        border-radius: 12px;
    }

    .msg-bubble.incoming {
        background: #17241e;
        border: 1px solid rgba(255, 255, 255, 0.05);
        color: #ffffff;
        border-bottom-left-radius: 2px;
    }

    .msg-bubble.outgoing {
        background: #0d281e;
        border: 1px solid #10b981;
        color: #ffffff;
        border-bottom-right-radius: 2px;
    }

    .msg-time-info {
        font-size: 10px;
        color: #526377;
        margin-top: 4px;
    }

    /* Footer Input */
    .chat-input-footer {
        padding: 16px 20px;
        background: #111a17;
        border-top: 1px solid #1a2c26;
    }

    .chat-send-form {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .chat-custom-input {
        background: #14201b;
        border: 1px solid #20352c;
        color: #ffffff;
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 13.5px;
    }

    .chat-custom-input:focus {
        background: #16241e;
        border-color: #10b981;
        color: #ffffff;
        box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.15);
    }

    .btn-chat-send {
        background: #10b981;
        color: #032015;
        border: none;
        font-weight: 700;
        font-size: 13px;
        padding: 10px 22px;
        border-radius: 10px;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .btn-chat-send:hover {
        background: #34d399;
        transform: translateY(-1px);
    }

    @@media (max-width: 900px) {
        .chat-layout-grid {
            grid-template-columns: 1fr;
            height: auto;
        }
        .chat-messages-stream {
            min-height: 400px;
        }
    }
</style>
