<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABSOLUTE CINEMA TECH OPERATIONS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-body: #0d1014;
            --bg-sidebar: #0f1318;
            --bg-card: #13181f;
            --bg-card-subtle: #171d26;
            --border-card: #1d242e;
            --border-subtle: rgba(255, 255, 255, 0.05);
            --accent-green: #10b981;
            --accent-green-glow: rgba(16, 185, 129, 0.35);
            --accent-red: #e50914;
            --text-primary: #ffffff;
            --text-secondary: #8e9bb0;
            --text-muted: #576579;
            --sidebar-w: 240px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Prompt', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            width: var(--sidebar-w);
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border-card);
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        .brand-header {
            padding: 22px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .brand-ac-badge {
            width: 34px;
            height: 34px;
            background: #14b8a6;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            color: #0d131a;
            font-size: 14px;
            letter-spacing: -0.5px;
            flex-shrink: 0;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

        .brand-title {
            font-size: 13.5px;
            font-weight: 700;
            color: #ffffff;
        }

        .brand-sub {
            font-size: 9px;
            font-weight: 700;
            color: #14b8a6;
            letter-spacing: 1px;
        }

        /* Nav List */
        .nav-list {
            padding: 16px 12px;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
            list-style: none;
            margin: 0;
            overflow-y: auto;
        }

        .nav-link-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            border-radius: 8px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .nav-link-item:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.03);
        }

        .nav-link-item.active {
            color: #ffffff;
            background: #182823;
            border: 1px solid #14b8a6;
        }

        .nav-link-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .badge-count-red {
            background: #e50914;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 10px;
        }

        /* Shift Card */
        .sidebar-shift-card {
            margin: 0 12px 14px;
            padding: 12px 14px;
            background: #141c24;
            border: 1px solid #1e2834;
            border-radius: 10px;
            font-size: 11px;
        }

        .shift-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 4px;
        }

        .badge-online-dot {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #10b981;
            font-size: 10px;
            font-weight: 600;
        }

        .badge-online-dot::before {
            content: '';
            width: 6px;
            height: 6px;
            background: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 6px #10b981;
        }

        .shift-time {
            color: #ffffff;
            font-weight: 600;
            font-size: 11.5px;
        }

        .shift-sub {
            color: var(--text-muted);
            font-size: 10px;
        }

        /* Profile Footer */
        .sidebar-user-footer {
            padding: 14px 18px;
            border-top: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #182e28;
            border: 1px solid #10b981;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: #10b981;
            flex-shrink: 0;
        }

        .user-text-box {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .user-name-th {
            font-size: 12.5px;
            font-weight: 600;
            color: #ffffff;
        }

        .user-role-en {
            font-size: 9.5px;
            color: var(--text-muted);
        }

        /* ===== CONTENT AREA ===== */
        .main-wrapper {
            margin-left: var(--sidebar-w);
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-body);
        }

        .content-body {
            padding: 26px 34px 60px;
            flex: 1;
        }

        /* Live Badge */
        .live-tag-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid #10b981;
            color: #10b981;
            font-size: 10.5px;
            font-weight: 700;
            padding: 2px 10px;
            border-radius: 12px;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
        <!-- Logo -->
        <div class="brand-header">
            <div class="brand-ac-badge">AC</div>
            <div class="brand-text">
                <span class="brand-title">Absolute Cinema</span>
                <span class="brand-sub">TECH OPERATIONS</span>
            </div>
        </div>

        <!-- Navigation Menu -->
        @{
            string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
            int unreadIncidents = ViewBag.UnreadIncidentsCount != null 
                ? (int)ViewBag.UnreadIncidentsCount 
                : (Context.Session.GetString("Incidents_Seen") == "true" ? 0 : 3);

            int unreadChat = ViewBag.UnreadChatCount != null 
                ? (int)ViewBag.UnreadChatCount 
                : (Context.Session.GetString("TechChat_Seen_group") == "true" && Context.Session.GetString("TechChat_Seen_admin") == "true" ? 0 : 3);
        }
        <ul class="nav-list">
            <li>
                <a asp-controller="Operations" asp-action="Index" class="nav-link-item @(currentAction == "Index" ? "active" : "")">
                    <div class="nav-link-left">
                        <i class="bi bi-speedometer2"></i>
                        <span>ศูนย์ควบคุม</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Operations" asp-action="Incidents" class="nav-link-item @(currentAction == "Incidents" ? "active" : "")">
                    <div class="nav-link-left">
                        <i class="bi bi-exclamation-octagon"></i>
                        <span>เหตุขัดข้อง</span>
                    </div>
                    @if (unreadIncidents > 0)
                    {
                        <span class="badge-count-red">@unreadIncidents</span>
                    }
                </a>
            </li>
            <li>
                <a asp-controller="Operations" asp-action="SystemHealth" class="nav-link-item @(currentAction == "SystemHealth" || currentAction == "Health" ? "active" : "")">
                    <div class="nav-link-left">
                        <i class="bi bi-cpu"></i>
                        <span>สุขภาพระบบ</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Operations" asp-action="Maintenance" class="nav-link-item @(currentAction == "Maintenance" ? "active" : "")">
                    <div class="nav-link-left">
                        <i class="bi bi-wrench"></i>
                        <span>งานบำรุงรักษา</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Operations" asp-action="Hardware" class="nav-link-item @(currentAction == "Hardware" ? "active" : "")">
                    <div class="nav-link-left">
                        <i class="bi bi-display"></i>
                        <span>อุปกรณ์และทรัพย์สิน</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Operations" asp-action="ShiftLog" class="nav-link-item @(currentAction == "ShiftLog" ? "active" : "")">
                    <div class="nav-link-left">
                        <i class="bi bi-journal-text"></i>
                        <span>บันทึกการเปลี่ยนเวร</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Operations" asp-action="TechChat" class="nav-link-item @(currentAction == "TechChat" ? "active" : "")">
                    <div class="nav-link-left">
                        <i class="bi bi-chat-dots"></i>
                        <span>แชททีมเทคนิค</span>
                    </div>
                    @if (unreadChat > 0)
                    {
                        <span class="badge-count-red">@unreadChat</span>
                    }
                </a>
            </li>

            <!-- Back to Home & Logout -->
            <li style="margin-top:auto; padding-top:14px; border-top: 1px solid var(--border-subtle);">
                <a asp-controller="Home" asp-action="Index" class="nav-link-item">
                    <div class="nav-link-left">
                        <i class="bi bi-house"></i>
                        <span>หน้าหลักภาพยนตร์</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Account" asp-action="Logout" class="nav-link-item">
                    <div class="nav-link-left">
                        <i class="bi bi-box-arrow-right text-danger"></i>
                        <span>ออกจากระบบ</span>
                    </div>
                </a>
            </li>
        </ul>

        <!-- Shift Info Card -->
        <div class="sidebar-shift-card">
            <div class="shift-top">
                <span style="color:var(--text-muted); font-size:9.5px;">กะการทำงาน</span>
                <span class="badge-online-dot">ออนไลน์</span>
            </div>
            <div class="shift-time">เวลากะกลางวัน • 08:00-17:00</div>
            <div class="shift-sub">ช่างประจำ 4 คน • On-Call 2 คน</div>
        </div>

        <!-- User Profile -->
        <div class="sidebar-user-footer">
            <div class="user-avatar-circle">
                <i class="bi bi-person-fill"></i>
            </div>
            <div class="user-text-box">
                <span class="user-name-th">@Context.Session.GetString("UserName")</span>
                <span class="user-role-en">หัวหน้าช่างเทคนิค</span>
            </div>
        </div>
    </aside>

    <!-- Main Wrapper -->
    <div class="main-wrapper">
        <main class="content-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background:#0a291e; border-color:#10b981; color:#34d399;">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

