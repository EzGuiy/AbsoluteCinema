<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABSOLUTE CINEMA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <style>
        :root {
            --bg-dark: #0a0a0a;
            --bg-card: rgba(20, 20, 20, 0.92);
            --gold: #d4a843;
            --gold-light: #f0d078;
            --gold-dark: #b8922e;
            --text-primary: #f0f0f0;
            --text-secondary: #999;
            --text-muted: #666;
            --border-color: rgba(212, 168, 67, 0.25);
            --input-bg: rgba(30, 30, 30, 0.9);
            --input-border: rgba(255, 255, 255, 0.1);
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            font-family: 'Prompt', sans-serif;
            background: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
        }

        /* ===== NAVBAR ===== */
        .auth-navbar {
            background: rgba(10, 10, 10, 0.95);
            border-bottom: 1px solid rgba(212, 168, 67, 0.15);
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .auth-navbar .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .auth-navbar .nav-logo .crown-icon {
            color: var(--gold);
            font-size: 22px;
        }

        .auth-navbar .nav-logo .brand-name {
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            font-weight: 700;
            font-style: italic;
            color: var(--gold);
            letter-spacing: 1px;
        }

        .nav-center-links {
            display: flex;
            align-items: center;
            gap: 0;
            list-style: none;
        }

        .nav-center-links li a {
            padding: 20px 18px;
            color: #ccc;
            text-decoration: none;
            font-size: 14px;
            font-weight: 400;
            transition: color 0.3s ease;
            position: relative;
        }

        .nav-center-links li a:hover {
            color: var(--gold);
        }

        .nav-center-links li a.nav-active {
            color: var(--gold);
        }

        .nav-center-links li a.nav-active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 30px;
            height: 2px;
            background: var(--gold);
        }

        .nav-right-btns {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .btn-login-nav {
            padding: 8px 20px;
            background: transparent;
            border: 1px solid var(--gold);
            color: var(--gold);
            border-radius: 4px;
            font-size: 13px;
            font-family: 'Prompt', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-login-nav:hover {
            background: rgba(212, 168, 67, 0.1);
        }

        .btn-register-nav {
            padding: 8px 20px;
            background: var(--gold);
            border: 1px solid var(--gold);
            color: #0a0a0a;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 500;
            font-family: 'Prompt', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-register-nav:hover {
            background: var(--gold-light);
            border-color: var(--gold-light);
        }

        /* ===== HERO / BACKGROUND ===== */
        .auth-hero {
            position: relative;
            min-height: calc(100vh - 64px - 280px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            overflow: hidden;
        }

        .auth-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: 
                linear-gradient(180deg, rgba(10,10,10,0.6) 0%, rgba(10,10,10,0.3) 30%, rgba(10,10,10,0.5) 70%, rgba(10,10,10,0.95) 100%),
                linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 25%, #1a1a1a 50%, #2d2d2d 75%, #1a1a1a 100%);
            z-index: 0;
        }

        /* Gold border lines top and bottom */
        .auth-hero .gold-line-top,
        .auth-hero .gold-line-bottom {
            position: absolute;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            z-index: 2;
            opacity: 0.5;
        }

        .auth-hero .gold-line-top { top: 0; }
        .auth-hero .gold-line-bottom { bottom: 0; }

        /* ===== AUTH CARD ===== */
        .auth-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 480px;
            background: var(--bg-card);
            border: 1px solid rgba(212, 168, 67, 0.12);
            border-radius: 12px;
            padding: 48px 40px;
            backdrop-filter: blur(20px);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
        }

        .auth-card-header {
            text-align: center;
            margin-bottom: 36px;
        }

        .auth-card-header .crown {
            color: var(--gold);
            font-size: 36px;
            margin-bottom: 12px;
            display: block;
        }

        .auth-card-header .brand {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 700;
            font-style: italic;
            color: var(--gold);
            letter-spacing: 2px;
            margin-bottom: 6px;
        }

        .auth-card-header .subtitle {
            font-size: 16px;
            font-weight: 500;
            color: var(--text-primary);
        }

        /* ===== FORM ELEMENTS ===== */
        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 400;
            color: #ccc;
            margin-bottom: 8px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper input {
            width: 100%;
            height: 48px;
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 6px;
            padding: 0 44px 0 16px;
            font-size: 14px;
            color: var(--text-primary);
            font-family: 'Prompt', sans-serif;
            transition: all 0.3s ease;
            outline: none;
        }

        .input-wrapper input::placeholder {
            color: var(--text-muted);
            font-size: 13px;
        }

        .input-wrapper input:focus {
            border-color: var(--gold);
            box-shadow: 0 0 0 2px rgba(212, 168, 67, 0.15);
        }

        .input-wrapper .input-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 16px;
            cursor: pointer;
            transition: color 0.3s;
        }

        .input-wrapper .input-icon:hover {
            color: var(--gold);
        }

        /* Checkbox */
        .form-check {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 16px 0;
        }

        .form-check input[type="checkbox"] {
            appearance: none;
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            border: 1px solid var(--input-border);
            border-radius: 4px;
            background: var(--input-bg);
            cursor: pointer;
            position: relative;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

        .form-check input[type="checkbox"]:checked {
            background: var(--gold);
            border-color: var(--gold);
        }

        .form-check input[type="checkbox"]:checked::after {
            content: '✓';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #000;
            font-size: 12px;
            font-weight: 700;
        }

        .form-check label {
            font-size: 13px;
            color: #aaa;
            cursor: pointer;
        }

        .form-check a {
            color: var(--gold);
            text-decoration: none;
        }

        /* Login row with remember me and forgot password */
        .login-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 16px 0 24px 0;
        }

        .login-options .form-check {
            margin: 0;
        }

        .forgot-password {
            font-size: 13px;
            color: var(--gold);
            text-decoration: none;
            transition: opacity 0.3s;
        }

        .forgot-password:hover {
            opacity: 0.8;
        }

        /* Submit button */
        .btn-submit {
            width: 100%;
            height: 50px;
            background: linear-gradient(135deg, var(--gold-dark), var(--gold), var(--gold-light));
            border: none;
            border-radius: 6px;
            color: #0a0a0a;
            font-size: 16px;
            font-weight: 600;
            font-family: 'Prompt', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 30px rgba(212, 168, 67, 0.35);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        /* Divider */
        .auth-divider {
            text-align: center;
            margin: 24px 0;
            position: relative;
        }

        .auth-divider::before {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: 50%;
            height: 1px;
            background: var(--input-border);
        }

        .auth-divider span {
            background: var(--bg-card);
            padding: 0 16px;
            position: relative;
            font-size: 13px;
            color: var(--text-muted);
        }

        /* Social buttons */
        .social-buttons {
            display: flex;
            gap: 12px;
        }

        .btn-social {
            flex: 1;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 6px;
            color: var(--text-primary);
            font-size: 14px;
            font-family: 'Prompt', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-social:hover {
            border-color: rgba(255, 255, 255, 0.2);
            background: rgba(40, 40, 40, 0.9);
        }

        .btn-social i {
            font-size: 16px;
        }

        /* Switch link */
        .auth-switch {
            text-align: center;
            margin-top: 28px;
            font-size: 14px;
            color: var(--text-muted);
        }

        .auth-switch a {
            color: var(--gold);
            text-decoration: none;
            font-weight: 500;
            transition: opacity 0.3s;
        }

        .auth-switch a:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        /* Error message */
        .auth-error {
            background: rgba(220, 53, 69, 0.12);
            border: 1px solid rgba(220, 53, 69, 0.3);
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 20px;
            color: #ff6b7a;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ===== FOOTER ===== */
        .auth-footer {
            background: rgba(10, 10, 10, 0.98);
            border-top: 1px solid rgba(212, 168, 67, 0.1);
            padding: 50px 40px 30px;
        }

        .footer-content {
            max-width: 1100px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-brand .footer-logo {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            font-weight: 700;
            font-style: italic;
            color: var(--gold);
            margin-bottom: 14px;
        }

        .footer-brand .footer-desc {
            font-size: 12px;
            color: #777;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .footer-social {
            display: flex;
            gap: 10px;
        }

        .footer-social a {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #888;
            text-decoration: none;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .footer-social a:hover {
            border-color: var(--gold);
            color: var(--gold);
            transform: translateY(-2px);
        }

        .footer-col h4 {
            font-size: 14px;
            font-weight: 600;
            color: var(--gold);
            margin-bottom: 20px;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col ul li {
            margin-bottom: 10px;
        }

        .footer-col ul li a {
            font-size: 13px;
            color: #777;
            text-decoration: none;
            transition: color 0.3s;
        }

        .footer-col ul li a:hover {
            color: var(--gold-light);
        }

        .footer-bottom {
            max-width: 1100px;
            margin: 0 auto;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .footer-bottom p {
            font-size: 12px;
            color: #555;
        }

        .footer-bottom .luxury-tag {
            font-family: 'Playfair Display', serif;
            font-style: italic;
            color: var(--gold);
            font-size: 12px;
            letter-spacing: 2px;
        }

        /* ===== ANIMATIONS ===== */
        .auth-card {
            animation: fadeInUp 0.6s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 768px) {
            .auth-navbar {
                padding: 0 20px;
            }

            .nav-center-links {
                display: none;
            }

            .auth-card {
                padding: 36px 24px;
                margin: 0 16px;
            }

            .footer-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 10px;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="auth-navbar">
        <a asp-controller="Home" asp-action="Index" class="nav-logo">
            <i class="fas fa-crown crown-icon"></i>
            <span class="brand-name">ABSOLUTE CINEMA</span>
        </a>

        <ul class="nav-center-links">
            <li><a asp-controller="Home" asp-action="Index" class="nav-active">หน้าแรก</a></li>
            <li><a asp-controller="Account" asp-action="UserList">รายชื่อผู้ใช้</a></li>
            <li><a asp-controller="Account" asp-action="AddUser">เพิ่มผู้ใช้</a></li>
