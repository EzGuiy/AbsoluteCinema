            <li><a asp-controller="Home" asp-action="ComingSoon">โปรแกรมหน้า</a></li>
        </ul>

        <div class="nav-right-btns">
            <a asp-controller="Account" asp-action="Login" class="btn-login-nav">เข้าสู่ระบบ</a>
            <a asp-controller="Account" asp-action="Register" class="btn-register-nav">สมัครสมาชิก</a>
        </div>
    </nav>

    <!-- Main Content -->
    @RenderBody()

    <!-- Footer -->
    <footer class="auth-footer">
        <div class="footer-content">
            <div class="footer-brand">
                <div class="footer-logo">ABSOLUTE CINEMA</div>
                <p class="footer-desc">
                    สัมผัสประสบการณ์การชมภาพยนตร์ระดับเวิลด์คลาส<br>
                    พร้อมบริการสุดหรูหรา สะดวกสบาย<br>
                    และเทคโนโลยีระบบภาพและเสียงที่ล้ำสมัยที่สุดในประเทศ
                </p>
                <div class="footer-social">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h4>เมนูหลัก</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
                    <li><a asp-controller="Home" asp-action="Promotions">โปรโมชั่น</a></li>
                    <li><a asp-controller="Home" asp-action="NowShowing">หนังกำลังฉาย</a></li>
                    <li><a asp-controller="Home" asp-action="ComingSoon">โปรแกรมหน้า</a></li>
                    <li><a>รอบพิเศษ</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>บริการลูกค้า</h4>
                <ul>
                    <li><a href="#">คำถามที่พบบ่อย</a></li>
                    <li><a href="#">นโยบายความเป็นส่วนตัว</a></li>
                    <li><a href="#">ข้อกำหนดการใช้งาน</a></li>
                    <li><a href="#">ติดต่อเรา</a></li>
                    <li><a href="#">แผนผังเว็บไซต์</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>ที่ตั้งและติดต่อ</h4>
                <ul>
                    <li><a href="#">ชั้น 5 สยามพารากอน แขวงปทุมวัน เขตปทุมวัน กรุงเทพมหานคร 10330</a></li>
                    <li><a href="#">โทร: 02-123-4567</a></li>
                    <li><a href="#">อีเมล: contact@cinemaxgold.com</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 CINEMAX GOLD. All rights reserved.</p>
            <span class="luxury-tag">LUXURY CINEMA EXPERIENCE</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
