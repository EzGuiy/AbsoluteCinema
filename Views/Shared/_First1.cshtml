<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineMax</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* ===== Reset & Base ===== */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-dark: #0a0a0f;
            --bg-card: #12121a;
            --bg-sidebar: #0e0e16;
            --bg-navbar: rgba(10, 10, 15, 0.85);
            --accent: #e50914;
            --accent-hover: #ff1a26;
            --accent-glow: rgba(229, 9, 20, 0.35);
            --gold: #f5c518;
            --text-primary: #f0f0f0;
            --text-secondary: #8a8a9a;
            --text-muted: #555566;
            --border-color: rgba(255, 255, 255, 0.06);
            --sidebar-width: 260px;
            --navbar-height: 64px;
            --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-dark);
            color: var(--text-primary);
            min-height: 100vh;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ===== Navbar ===== */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--navbar-height);
            background: var(--bg-navbar);
            backdrop-filter: blur(20px) saturate(1.5);
            -webkit-backdrop-filter: blur(20px) saturate(1.5);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px 0 0;
            z-index: 1000;
        }

        /* Logo area */
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            width: var(--sidebar-width);
            padding: 0 24px;
            height: 100%;
            flex-shrink: 0;
        }

        .navbar-brand .logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--accent), #ff6b35);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 800;
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        .navbar-brand .logo-text {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #fff, #ccc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .navbar-brand .logo-text span {
            background: linear-gradient(135deg, var(--accent), #ff6b35);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Search bar */
        .navbar-search {
            flex: 1;
            max-width: 480px;
            position: relative;
        }

        .navbar-search input {
            width: 100%;
            height: 40px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0 16px 0 42px;
            font-size: 14px;
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            transition: var(--transition);
            outline: none;
        }

        .navbar-search input::placeholder {
            color: var(--text-muted);
        }

        .navbar-search input:focus {
            border-color: var(--accent);
            background: rgba(229, 9, 20, 0.05);
            box-shadow: 0 0 0 3px rgba(229, 9, 20, 0.1);
        }

        .navbar-search .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 14px;
            pointer-events: none;
        }

        /* Nav actions */
        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-action-btn {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
            font-size: 16px;
        }

        .nav-action-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-primary);
            border-color: rgba(255, 255, 255, 0.12);
            transform: translateY(-1px);
        }

        .nav-action-btn .badge {
            position: absolute;
            top: -4px;
            right: -4px;
            width: 18px;
            height: 18px;
            background: var(--accent);
            border-radius: 50%;
            font-size: 10px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            box-shadow: 0 2px 8px var(--accent-glow);
        }

        .nav-divider {
            width: 1px;
            height: 28px;
            background: var(--border-color);
            margin: 0 8px;
        }

        /* User profile */
        .nav-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 12px 4px 4px;
            border-radius: 12px;
            cursor: pointer;
            transition: var(--transition);
        }

        .nav-user:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .nav-user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            color: #fff;
        }

        .nav-user-info {
            display: flex;
            flex-direction: column;
        }

        .nav-user-name {
            font-size: 13px;
            font-weight: 600;
            line-height: 1.2;
        }

        .nav-user-role {
            font-size: 11px;
            color: var(--text-muted);
        }

        /* ===== Sidebar ===== */
        .sidebar {
            position: fixed;
            top: var(--navbar-height);
            left: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            z-index: 900;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 16px 12px;
        }

        .sidebar::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }

        /* Sidebar section */
        .sidebar-section {
            margin-bottom: 24px;
        }

        .sidebar-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--text-muted);
            padding: 0 12px;
            margin-bottom: 8px;
        }

        /* Sidebar nav items */
        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-secondary);
            cursor: pointer;
            transition: var(--transition);
            position: relative;
            white-space: nowrap;
        }

        .sidebar-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-primary);
        }

        .sidebar-item.active {
            background: rgba(229, 9, 20, 0.1);
            color: var(--accent);
        }

        .sidebar-item.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 20px;
            background: var(--accent);
            border-radius: 0 4px 4px 0;
        }

        .sidebar-item .item-icon {
            width: 20px;
            text-align: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .sidebar-item .item-badge {
            margin-left: auto;
            padding: 2px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
        }

        .item-badge.new {
            background: rgba(229, 9, 20, 0.15);
            color: var(--accent);
        }

        .item-badge.count {
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-secondary);
        }

        .item-badge.hot {
            background: rgba(245, 197, 24, 0.15);
            color: var(--gold);
        }

        /* Sidebar promo card */
        .sidebar-promo {
            margin: auto 4px 8px 4px;
            padding: 20px 16px;
            background: linear-gradient(135deg, rgba(229, 9, 20, 0.15), rgba(255, 107, 53, 0.1));
            border: 1px solid rgba(229, 9, 20, 0.2);
            border-radius: 14px;
            text-align: center;
        }

        .sidebar-promo .promo-icon {
            font-size: 32px;
            margin-bottom: 8px;
        }

        .sidebar-promo .promo-title {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .sidebar-promo .promo-desc {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 14px;
            line-height: 1.5;
        }

        .sidebar-promo .promo-btn {
            display: inline-block;
            padding: 8px 20px;
            background: linear-gradient(135deg, var(--accent), #ff6b35);
            color: #fff;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        .sidebar-promo .promo-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px var(--accent-glow);
        }

        /* ===== Main Content ===== */
        .layout-main {
            margin-left: var(--sidebar-width);
            margin-top: var(--navbar-height);
            min-height: calc(100vh - var(--navbar-height));
            padding: 24px;
        }

        /* ===== Footer ===== */
        .layout-footer {
            margin-left: var(--sidebar-width);
            padding: 20px 24px;
            border-top: 1px solid var(--border-color);
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
        }

        /* ===== Tooltip / Subtle Animations ===== */
        .pulse {
            animation: pulse-anim 2s ease-in-out infinite;
        }

        @@keyframes pulse-anim {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }

        /* Sidebar hover glow */
        .sidebar-item:hover .item-icon {
            filter: drop-shadow(0 0 4px rgba(255,255,255,0.2));
        }

        .sidebar-item.active .item-icon {
            filter: drop-shadow(0 0 6px var(--accent-glow));
        }
    </style>
</head>
<body>

    <!-- ===== Navbar ===== -->
    <nav class="navbar">
        <!-- Brand / Logo -->
        <a asp-controller="Home" asp-action="Index" class="navbar-brand">
            <div class="logo-icon">🎬</div>
            <div class="logo-text">Cine<span>Max</span></div>
        </a>

        <!-- Search -->
        <div class="navbar-search">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="ค้นหาหนัง, โรงหนัง, รอบฉาย..." />
        </div>

        <!-- Actions -->
        <div class="navbar-actions">
            <button class="nav-action-btn" title="การแจ้งเตือน">
                🔔
                <span class="badge">3</span>
            </button>
            <button class="nav-action-btn" title="ตั๋วของฉัน">
                🎟️
            </button>
            <button class="nav-action-btn" title="รายการโปรด">
                ❤️
            </button>

            <div class="nav-divider"></div>

            <!-- User Profile -->
            <div class="nav-user">
                <div class="nav-user-avatar">KG</div>
                <div class="nav-user-info">
                    <span class="nav-user-name">Kawin G.</span>
                    <span class="nav-user-role">Premium Member</span>
                </div>
            </div>
        </div>
    </nav>

    <!-- ===== Sidebar ===== -->
    <aside class="sidebar">
        <!-- Main Menu -->
        <div class="sidebar-section">
            <div class="sidebar-label">เมนูหลัก</div>
            <div class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="sidebar-item active">
                    <span class="item-icon">🏠</span>
                    หน้าแรก
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">🎬</span>
                    หนังกำลังฉาย
                    <span class="item-badge hot">HOT</span>
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">📅</span>
                    หนังเร็วๆ นี้
                    <span class="item-badge new">NEW</span>
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">🏢</span>
                    เลือกโรงหนัง
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">🎟️</span>
                    จองตั๋ว
                </a>
            </div>
        </div>

        <!-- Categories -->
        <div class="sidebar-section">
            <div class="sidebar-label">หมวดหมู่</div>
            <div class="sidebar-nav">
                <a class="sidebar-item">
                    <span class="item-icon">💥</span>
                    แอ็กชัน
                    <span class="item-badge count">24</span>
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">😂</span>
                    ตลก
                    <span class="item-badge count">18</span>
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">👻</span>
                    สยองขวัญ
                    <span class="item-badge count">12</span>
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">💕</span>
                    โรแมนติก
                    <span class="item-badge count">15</span>
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">🦸</span>
                    ซูเปอร์ฮีโร่
                    <span class="item-badge count">9</span>
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">🎭</span>
                    ดราม่า
                    <span class="item-badge count">21</span>
                </a>
            </div>
        </div>

        <!-- Account -->
        <div class="sidebar-section">
            <div class="sidebar-label">บัญชีของฉัน</div>
            <div class="sidebar-nav">
                <a class="sidebar-item">
                    <span class="item-icon">📜</span>
                    ประวัติการจอง
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">⭐</span>
                    รายการโปรด
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">👤</span>
                    โปรไฟล์
                </a>
                <a class="sidebar-item">
                    <span class="item-icon">⚙️</span>
                    ตั้งค่า
                </a>
            </div>
        </div>

        <!-- Promo Card -->
        <div class="sidebar-promo">
            <div class="promo-icon">🍿</div>
            <div class="promo-title">สมาชิก Premium</div>
            <div class="promo-desc">รับส่วนลด 20% ทุกรอบฉาย และข้อเสนอพิเศษอีกมากมาย</div>
            <button class="promo-btn">อัปเกรดเลย</button>
        </div>
    </aside>

    <!-- ===== Main Content ===== -->
    <main class="layout-main">
        @RenderBody()
    </main>

    <!-- ===== Footer ===== -->
    <footer class="layout-footer">
        &copy; @DateTime.Now.Year CineMax — ระบบจองตั๋วหนังออนไลน์
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>