<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABSOLUTE CINEMA FLOOR OPERATIONS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --bg-body: #0b0f15;
            --bg-sidebar: #0e131b;
            --bg-card: #121924;
            --bg-card-subtle: #172130;
            --border-card: #1c2838;
            --border-subtle: rgba(255, 255, 255, 0.05);
            --accent-cyan: #0ea5e9;
            --accent-cyan-hover: #38bdf8;
            --accent-cyan-glow: rgba(14, 165, 233, 0.3);
            --accent-green: #10b981;
            --accent-amber: #f59e0b;
            --accent-red: #e50914;
            --text-primary: #ffffff;
            --text-secondary: #8fa0b5;
            --text-muted: #526377;
            --sidebar-w: 245px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Prompt', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        /* ===== SIDEBAR ===== */
        .sidebar-staff {
            width: var(--sidebar-w);
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border-card);
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 1000;
        }

        .brand-header-staff {
            padding: 22px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .brand-ac-cyan {
            width: 36px;
            height: 36px;
            background: #0284c7;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            color: #ffffff;
            font-size: 14px;
            flex-shrink: 0;
            box-shadow: 0 0 12px var(--accent-cyan-glow);
        }

        .brand-texts-staff {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

        .staff-brand-title {
            font-size: 13.5px;
            font-weight: 700;
            color: #ffffff;
        }

        .staff-brand-sub {
            font-size: 9.5px;
            font-weight: 700;
            color: #38bdf8;
            letter-spacing: 1px;
        }

        /* Nav List */
        .nav-list-staff {
            padding: 14px 12px;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 4px;
            list-style: none;
            margin: 0;
            overflow-y: auto;
        }

        .staff-nav-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            border-radius: 8px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .staff-nav-link:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.03);
        }

        .staff-nav-link.active {
            color: #ffffff;
            background: rgba(14, 165, 233, 0.12);
            border: 1px solid #0ea5e9;
        }

        .staff-nav-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .badge-cyan-pill {
            background: #0284c7;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 1px 7px;
            border-radius: 10px;
        }

        /* Shift Card */
        .sidebar-shift-box {
            margin: 0 12px 14px;
            padding: 12px 14px;
            background: #121a24;
            border: 1px solid #1c2838;
            border-radius: 10px;
            font-size: 11px;
        }

        .shift-top-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 4px;
        }

        .badge-duty-dot {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #10b981;
            font-size: 10px;
            font-weight: 600;
        }

        .badge-duty-dot::before {
            content: '';
            width: 6px;
            height: 6px;
            background: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 6px #10b981;
        }

        .shift-time-val {
            color: #ffffff;
            font-weight: 600;
            font-size: 11.5px;
        }

        .shift-desc {
            color: var(--text-muted);
            font-size: 10px;
        }

        /* Profile Footer */
        .sidebar-user-footer {
            padding: 14px 18px;
            border-top: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar-cyan {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #0c4a6e;
            border: 1px solid #0ea5e9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: #38bdf8;
            flex-shrink: 0;
        }

        .user-name-th {
            font-size: 12.5px;
            font-weight: 600;
            color: #ffffff;
        }

        .user-role-en {
            font-size: 9.5px;
            color: var(--text-muted);
        }

        /* ===== MAIN WRAPPER ===== */
        .main-wrapper {
            margin-left: var(--sidebar-w);
            flex: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-body);
        }

        .content-body {
            padding: 26px 36px 60px;
            flex: 1;
        }
    </style>
</head>
<body>
    <!-- Sidebar Navigation -->
    <aside class="sidebar-staff">
        <!-- Logo -->
        <div class="brand-header-staff">
            <div class="brand-ac-cyan">AC</div>
            <div class="brand-texts-staff">
                <span class="staff-brand-title">Absolute Cinema</span>
                <span class="staff-brand-sub">FLOOR OPERATIONS</span>
            </div>
        </div>

        <!-- Navigation Menu -->
        <ul class="nav-list-staff">
            <li>
                <a asp-controller="Staff" asp-action="Index" 
                   class="staff-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <div class="staff-nav-left">
                        <i class="bi bi-grid-fill"></i>
                        <span>ภาพรวม & สถิติ</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Staff" asp-action="Halls" 
                   class="staff-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Halls" ? "active" : "")">
                    <div class="staff-nav-left">
                        <i class="bi bi-display-fill"></i>
                        <span>ตรวจโรงภาพยนตร์</span>
                    </div>
                    <span class="badge-cyan-pill">8 โรง</span>
                </a>
            </li>
            @{
                int unreadStaffChat = ViewBag.UnreadStaffChatCount != null 
                    ? (int)ViewBag.UnreadStaffChatCount 
                    : (Context.Session.GetString("StaffChat_Seen_group") == "true" && Context.Session.GetString("StaffChat_Seen_admin") == "true" ? 0 : 3);
            }
            <li>
                <a asp-controller="Staff" asp-action="Chat" 
                   class="staff-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Chat" ? "active" : "")">
                    <div class="staff-nav-left">
                        <i class="bi bi-chat-dots-fill"></i>
                        <span>แชทภายใน</span>
                    </div>
                    @if (unreadStaffChat > 0)
                    {
                        <span class="badge-cyan-pill" style="background:#e50914;">@unreadStaffChat</span>
                    }
                </a>
            </li>

            <!-- Switch Role Links -->
            <li style="margin-top:auto; padding-top:14px; border-top: 1px solid var(--border-subtle);">
                <a asp-controller="Manager" asp-action="Index" class="staff-nav-link">
                    <div class="staff-nav-left">
                        <i class="bi bi-briefcase text-warning"></i>
                        <span>ผู้จัดการ (Manager)</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Operations" asp-action="Index" class="staff-nav-link">
                    <div class="staff-nav-left">
                        <i class="bi bi-speedometer2 text-success"></i>
                        <span>ฝ่ายเทคนิค (Tech Ops)</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Accountant" asp-action="Dashboard" class="staff-nav-link">
                    <div class="staff-nav-left">
                        <i class="bi bi-calculator text-danger"></i>
                        <span>ฝ่ายบัญชี (Accountant)</span>
                    </div>
                </a>
            </li>
            <li>
                <a asp-controller="Home" asp-action="Index" class="staff-nav-link">
                    <div class="staff-nav-left">
                        <i class="bi bi-house"></i>
                        <span>หน้าหลักโรงหนัง</span>
                    </div>
                </a>
            </li>
        </ul>

        <!-- Shift Box -->
        <div class="sidebar-shift-box">
            <div class="shift-top-row">
                <span style="color:var(--text-muted); font-size:9.5px;">กะการทำงาน</span>
                <span class="badge-duty-dot">ประจำการพร้อม</span>
            </div>
            <div class="shift-time-val">เวลากะ • 09:00-18:00 น.</div>
            <div class="shift-desc">พนักงานบริการ 6 คน • ตรวจตั๋ว 4 คน</div>
        </div>

        <!-- Profile Footer -->
        <div class="sidebar-user-footer">
            <div class="user-avatar-cyan">
                <i class="bi bi-person-fill"></i>
            </div>
            <div class="user-text-box">
                <div class="user-name-th">สมศรี รักบริการ</div>
                <div class="user-role-en">FLOOR STAFF</div>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper">
        <main class="content-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background:#082820; border-color:#10b981; color:#34d399;">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="background:#2d1115; border-color:#e50914; color:#ff6b7d;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

