@model Kawin_67091861_002.ViewModels.IncomeExpensesViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "รายรับ-รายจ่าย";
    Layout = "_LayoutAccountant";
}

<!-- Page Header with Live Status & Add Button -->
<div class="page-top-header">
    <div>
        <div class="header-pre-title">INCOME & EXPENSES</div>
        <h1 class="header-main-title">รายรับ-รายจ่าย</h1>
    </div>
    <div style="display:flex; align-items:center; gap:12px;">
        <button type="button" class="btn-add-txn" data-bs-toggle="modal" data-bs-target="#addTxnModal">
            <i class="bi bi-plus-circle-fill"></i> บันทึกรายการใหม่
        </button>
        <div class="system-live-badge">
            <span class="live-dot"></span>
            <span>SYSTEM LIVE</span>
        </div>
    </div>
</div>

<!-- Net Profit Report Banner -->
<div class="net-profit-banner">
    <div class="profit-left">
        <div class="profit-pre-title">NET PROFIT REPORT</div>
        <h2 class="profit-title">กำไรสุทธิวันนี้ (Net Profit)</h2>
    </div>
    <div class="profit-right">
        <div class="profit-amount @(Model.NetProfit >= 0 ? "positive" : "negative")">
            @Model.NetProfitFormatted
        </div>
        <div class="profit-badge-pill">
            @Model.MarginStatus
        </div>
    </div>
</div>

<!-- Income & Expense Breakdown Row -->
<div class="breakdown-grid">
    <!-- Left Card: Income Breakdown -->
    <div class="card-panel">
        <div class="card-header-split">
            <div>
                <div class="card-pre-title">INCOME BREAKDOWN</div>
                <h3 class="card-title mb-0">รายการรายรับประจำวัน</h3>
            </div>
            <div class="breakdown-total green">
                ฿@Model.TotalIncome.ToString("N0")
            </div>
        </div>

        <div class="financial-items-list">
            @foreach (var item in Model.IncomeBreakdown)
            {
                <div class="financial-row">
                    <div class="f-info">
                        <span class="f-title">@item.CategoryName</span>
                        <span class="f-sub">@item.Subtitle</span>
                    </div>
                    <div class="f-amount">
                        @item.AmountFormatted
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Right Card: Expense Breakdown -->
    <div class="card-panel">
        <div class="card-header-split">
            <div>
                <div class="card-pre-title">EXPENSE BREAKDOWN</div>
                <h3 class="card-title mb-0">รายการค่าใช้จ่ายประจำวัน</h3>
            </div>
            <div class="breakdown-total red">
                -฿@Model.TotalExpenses.ToString("N0")
            </div>
        </div>

        <div class="financial-items-list">
            @foreach (var item in Model.ExpenseBreakdown)
            {
                <div class="financial-row">
                    <div class="f-info">
                        <span class="f-title">@item.CategoryName</span>
                        <span class="f-sub">@item.Subtitle</span>
                    </div>
                    <div class="f-amount expense">
                        @item.AmountFormatted
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Bottom Row: Income vs Expenses Past 30 Days (Bar Chart) -->
<div class="card-panel monthly-chart-card">
    <div class="card-pre-title">INCOME VS EXPENSES (PAST 30 DAYS)</div>
    <h3 class="card-title">เปรียบเทียบรายรับและรายจ่ายในรอบ 30 วัน</h3>

    <div class="bar-chart-container">
        <canvas id="monthlyBarChart" height="230"></canvas>
    </div>

    <!-- Chart Legend -->
    <div class="chart-custom-legend">
        <div class="leg-item">
            <span class="leg-color green"></span>
            <span>รายรับรวม (Income)</span>
        </div>
        <div class="leg-item">
            <span class="leg-color red"></span>
            <span>รายจ่ายรวม (Expenses)</span>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MODAL: บันทึกรายการรายรับ-รายจ่ายจริงลงระบบ -->
<!-- ============================================== -->
<div class="modal fade" id="addTxnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-dark-modal">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-wallet2 text-danger me-2"></i> บันทึกรายการทางการเงินใหม่</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Accountant" asp-action="AddTransaction" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-secondary small">ประเภทรายการ</label>
                        <select name="Type" class="form-select dark-input" required>
                            <option value="Income">รายรับ (Income)</option>
                            <option value="Expense">รายจ่าย (Expense)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">หมวดหมู่</label>
                        <select name="Category" class="form-select dark-input" required>
                            <optgroup label="หมวดรายรับ">
                                <option value="Ticket Sales">ตั๋วภาพยนตร์ (Ticket Sales)</option>
                                <option value="Concessions">ขนมและเครื่องดื่ม (Concessions)</option>
                                <option value="Merchandise">สินค้าของพรีเมียม (Merchandise)</option>
                                <option value="Advertising">โฆษณาในโรงหนัง (Advertising)</option>
                            </optgroup>
                            <optgroup label="หมวดรายจ่าย">
                                <option value="Staff Wages">ค่าจ้างพนักงาน (Staff Wages)</option>
                                <option value="Utilities">สาธารณูปโภค ค่าไฟ แอร์ (Utilities)</option>
                                <option value="Supplies">พัสดุและวัตถุดิบ (Supplies)</option>
                                <option value="Maintenance">การบำรุงรักษาเครื่อง (Maintenance)</option>
                                <option value="Licensing">ส่วนแบ่งลิขสิทธิ์หนัง (Licensing)</option>
                            </optgroup>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">รายละเอียดรายการ</label>
                        <input type="text" name="Description" class="form-control dark-input" placeholder="เช่น ค่าเครื่องดื่มนำเข้า, ค่าไฟรอบดึก" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">จำนวนเงิน (บาท)</label>
                        <input type="number" step="0.01" name="Amount" class="form-control dark-input" placeholder="0.00" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary small">หมายเหตุเพิ่มเติม</label>
                        <textarea name="Notes" class="form-control dark-input" rows="2" placeholder="ระบุเลขที่เอกสาร หรือหมายเหตุประกอบ"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-danger btn-sm px-4">บันทึกลงระบบจริง</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Page Header */
    .page-top-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .header-pre-title {
        font-size: 11px;
        font-weight: 700;
        color: var(--accent-red);
        letter-spacing: 1.5px;
        margin-bottom: 4px;
    }

    .header-main-title {
        font-size: 26px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .btn-add-txn {
        background: rgba(229, 9, 20, 0.15);
        border: 1px solid var(--accent-red);
        color: #ffffff;
        font-size: 13px;
        font-weight: 500;
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }

    .btn-add-txn:hover {
        background: var(--accent-red);
        color: #fff;
    }

    /* Net Profit Banner */
    .net-profit-banner {
        background: var(--bg-card);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .profit-pre-title {
        font-size: 10.5px;
        font-weight: 700;
        color: var(--accent-red);
        letter-spacing: 1.5px;
        margin-bottom: 4px;
    }

    .profit-title {
        font-size: 19px;
        font-weight: 600;
        color: #ffffff;
        margin: 0;
    }

    .profit-right {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .profit-amount {
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .profit-amount.positive {
        color: #34d399;
    }

    .profit-amount.negative {
        color: #f87171;
    }

    .profit-badge-pill {
        background: rgba(18, 183, 106, 0.1);
        border: 1px solid rgba(18, 183, 106, 0.35);
        color: var(--accent-green);
        font-size: 12px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 20px;
    }

    /* Breakdown Grid */
    .breakdown-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .card-panel {
        background-color: var(--bg-card);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        padding: 24px;
    }

    .card-header-split {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-subtle);
    }

    .card-pre-title {
        font-size: 10px;
        font-weight: 700;
        color: var(--accent-red);
        letter-spacing: 1.5px;
        margin-bottom: 4px;
    }

    .card-title {
        font-size: 16px;
        font-weight: 600;
        color: #ffffff;
    }

    .breakdown-total {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.3px;
    }

    .breakdown-total.green { color: #ffffff; }
    .breakdown-total.red { color: var(--accent-red); }

    /* Financial Rows */
    .financial-items-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .financial-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .financial-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .f-info {
        display: flex;
        flex-direction: column;
        line-height: 1.25;
    }

    .f-title {
        font-size: 13.5px;
        font-weight: 500;
        color: #ffffff;
    }

    .f-sub {
        font-size: 10px;
        color: var(--text-muted);
    }

    .f-amount {
        font-size: 14.5px;
        font-weight: 600;
        color: #ffffff;
    }

    .f-amount.expense {
        color: #ffffff;
    }

    /* Bar Chart Box */
    .monthly-chart-card {
        padding: 24px;
    }

    .bar-chart-container {
        width: 100%;
        position: relative;
    }

    .chart-custom-legend {
        display: flex;
        gap: 20px;
        margin-top: 16px;
        font-size: 12px;
        color: var(--text-secondary);
    }

    .leg-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .leg-color {
        width: 10px;
        height: 10px;
        border-radius: 2px;
    }

    .leg-color.green { background: #34d399; }
    .leg-color.red { background: #e50914; }

    /* Modal Styling */
    .custom-dark-modal {
        background: #14141a;
        border: 1px solid var(--border-card);
        color: #ffffff;
    }

    .custom-dark-modal .modal-header {
        border-bottom: 1px solid var(--border-subtle);
    }

    .custom-dark-modal .modal-footer {
        border-top: 1px solid var(--border-subtle);
    }

    .dark-input {
        background: #0d0d12;
        border: 1px solid #282834;
        color: #ffffff;
        font-size: 13.5px;
    }

    .dark-input:focus {
        background: #0d0d12;
        border-color: var(--accent-red);
        color: #ffffff;
        box-shadow: 0 0 0 3px rgba(229, 9, 20, 0.2);
    }

    @@media (max-width: 992px) {
        .breakdown-grid {
            grid-template-columns: 1fr;
        }
        .net-profit-banner {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
    }
</style>

@section Scripts {
<script>
    const barCtx = document.getElementById('monthlyBarChart').getContext('2d');
    const weekLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyComparison.Select(w => w.WeekLabel)));
    const incomeData = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyComparison.Select(w => w.Income)));
    const expenseData = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyComparison.Select(w => w.Expenses)));

    new Chart(barCtx, {
        type: 'bar',
        data: {
            labels: weekLabels,
            datasets: [
                {
                    label: 'รายรับรวม (Income)',
                    data: incomeData,
                    backgroundColor: '#34d399',
                    borderRadius: 4,
                    barPercentage: 0.6,
                    categoryPercentage: 0.5
                },
                {
                    label: 'รายจ่ายรวม (Expenses)',
                    data: expenseData,
                    backgroundColor: '#e50914',
                    borderRadius: 4,
                    barPercentage: 0.6,
                    categoryPercentage: 0.5
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#191920',
                    callbacks: {
                        label: function(context) {
                            return ' ' + context.dataset.label + ': ฿' + Number(context.raw).toLocaleString();
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { color: '#666675', font: { family: 'Prompt', size: 11 } }
                },
                y: {
                    grid: { color: 'rgba(255, 255, 255, 0.04)' },
                    ticks: {
                        color: '#666675',
                        font: { family: 'Prompt', size: 10 },
                        callback: function(value) { return '฿' + (value / 1000000) + 'M'; }
                    }
                }
            }
        }
    });
</script>
}
