@model Kawin_67091861_002.ViewModels.ManagerChatViewModel
@{
    ViewData["Title"] = "แชททีมงาน (Admin Console)";
    Layout = "_LayoutAuth";
}

<style>
    .admin-chat-wrapper {
        max-width: 1280px;
        margin: 20px auto 40px;
        padding: 0 20px;
    }

    .admin-chat-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .admin-chat-title-group h1 {
        font-size: 24px;
        font-weight: 700;
        color: #f0f0f0;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .admin-chat-title-group p {
        font-size: 13px;
        color: #888;
        margin: 4px 0 0;
    }

    .admin-live-tag {
        background: rgba(212, 168, 67, 0.15);
        color: #d4a843;
        border: 1px solid rgba(212, 168, 67, 0.3);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .admin-live-dot {
        width: 8px;
        height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 6px #10b981;
    }

    /* Grid Layout (Group Chat Only) */
    .admin-chat-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        height: calc(100vh - 220px);
        min-height: 600px;
        background: rgba(18, 18, 22, 0.95);
        border: 1px solid rgba(212, 168, 67, 0.2);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }

    /* Sidebar Channels */
    .admin-rooms-sidebar {
        background: rgba(14, 14, 18, 0.98);
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .admin-rooms-top {
        padding: 16px 18px 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .admin-search-input {
        width: 100%;
        background: rgba(30, 30, 36, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 8px 14px;
        color: #fff;
        font-size: 13px;
        outline: none;
        transition: 0.2s;
    }

    .admin-search-input:focus {
        border-color: #d4a843;
    }

    .admin-rooms-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 12px 10px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .admin-section-label {
        font-size: 11px;
        font-weight: 700;
        color: #d4a843;
        letter-spacing: 1px;
        padding: 10px 12px 4px;
        text-transform: uppercase;
    }

    .admin-room-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 14px;
        border-radius: 10px;
        text-decoration: none;
        color: #ccc;
        border: 1px solid transparent;
        transition: all 0.2s;
        cursor: pointer;
    }

    .admin-room-card:hover {
        background: rgba(255, 255, 255, 0.04);
        color: #fff;
    }

    .admin-room-card.active {
        background: rgba(212, 168, 67, 0.12);
        border-color: rgba(212, 168, 67, 0.4);
        color: #fff;
    }

    .room-avatar-badge {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        background: rgba(212, 168, 67, 0.15);
        color: #d4a843;
        border: 1px solid rgba(212, 168, 67, 0.3);
    }

    .room-avatar-badge.blue {
        background: rgba(59, 130, 246, 0.15);
        color: #60a5fa;
        border-color: rgba(59, 130, 246, 0.3);
    }

    .room-avatar-badge.green {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border-color: rgba(16, 185, 129, 0.3);
    }

    .room-avatar-badge.gold {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border-color: rgba(245, 158, 11, 0.3);
    }

    .room-avatar-badge.red {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border-color: rgba(239, 68, 68, 0.3);
    }

    .room-meta-box {
        flex: 1;
        min-width: 0;
    }

    .room-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 3px;
    }

    .room-member-name {
        font-size: 13.5px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #ffffff;
    }

    .room-preview-text {
        font-size: 11.5px;
        color: #888;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .unread-pill {
        background: #e50914;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 1px 7px;
        border-radius: 10px;
    }

    /* Main Conversation */
    .admin-chat-main {
        display: flex;
        flex-direction: column;
        background: rgba(14, 14, 18, 0.85);
        overflow: hidden;
    }

    .admin-main-header {
        padding: 16px 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(20, 20, 26, 0.95);
    }

    .admin-main-header-info h2 {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin: 0;
    }

    .admin-main-header-info span {
        font-size: 12px;
        color: #d4a843;
    }

    .admin-messages-box {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .chat-bubble-entry {
        display: flex;
        flex-direction: column;
        gap: 4px;
        max-width: 78%;
    }

    .chat-bubble-entry.mine {
        align-self: flex-end;
    }

    .chat-bubble-entry.theirs {
        align-self: flex-start;
    }

    .entry-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        color: #777;
    }

    .chat-bubble-entry.mine .entry-meta {
        justify-content: flex-end;
    }

    .entry-sender-name {
        font-weight: 700;
        color: #eee;
    }

    .entry-bubble-mine {
        background: rgba(212, 168, 67, 0.18);
        border: 1px solid rgba(212, 168, 67, 0.4);
        color: #fff;
        padding: 12px 16px;
        border-radius: 12px;
        border-bottom-right-radius: 2px;
        font-size: 13.5px;
        line-height: 1.5;
    }

    .entry-bubble-theirs {
        background: rgba(30, 30, 38, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e5e5e5;
        padding: 12px 16px;
        border-radius: 12px;
        border-bottom-left-radius: 2px;
        font-size: 13.5px;
        line-height: 1.5;
    }

    /* Input Bar */
    .admin-input-bar {
        padding: 16px 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(20, 20, 26, 0.98);
    }

    .admin-send-form {
        display: flex;
        gap: 12px;
    }

    .admin-text-field {
        flex: 1;
        background: rgba(30, 30, 38, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #fff;
        padding: 11px 18px;
        border-radius: 8px;
        font-size: 13.5px;
        outline: none;
        transition: 0.2s;
    }

    .admin-text-field:focus {
        border-color: #d4a843;
    }

    .btn-send-gold {
        background: #d4a843;
        color: #0a0a0a;
        font-weight: 700;
        font-size: 13px;
        padding: 10px 22px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
    }

    .btn-send-gold:hover {
        background: #f0d078;
    }

    @@media (max-width: 900px) {
        .admin-chat-grid {
            grid-template-columns: 1fr;
            height: auto;
        }
    }
</style>

<div class="admin-chat-wrapper">
    <!-- Header -->
    <div class="admin-chat-header-bar">
        <div class="admin-chat-title-group">
            <h1><i class="fas fa-users" style="color: #d4a843;"></i> แชททีมงานรวมทุกแผนก (Team Chat)</h1>
            <p>ห้องสนทนารวมสำหรับผู้ดูแลระบบ ผู้จัดการ พนักงานบริการ ช่างเทคนิค และฝ่ายบัญชี</p>
        </div>
        <div>
            <span class="admin-live-tag">
                <span class="admin-live-dot"></span> LIVE SYSTEM
            </span>
        </div>
    </div>

    <!-- Single-Column Group Chat -->
    <div class="admin-chat-grid">
        <!-- Main Chat Panel -->
        <div class="admin-chat-main">
            <!-- Header -->
            <div class="admin-main-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="room-avatar-badge blue" style="width: 40px; height: 40px;">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="admin-main-header-info">
                        <h2>@Model.ActiveRoom.Name</h2>
                        <span>@Model.ActiveRoom.MembersInfo</span>
                    </div>
                </div>
            </div>

            <!-- Messages Stream -->
            <div class="admin-messages-box" id="adminMsgBox">
                @if (!Model.Messages.Any())
                {
                    <div style="text-align: center; color: #777; margin-top: 60px;">
                        <i class="far fa-comment-dots" style="font-size: 36px; display: block; margin-bottom: 12px; color: #555;"></i>
                        ยังไม่มีข้อความในห้องนี้ พิมพ์ข้อความเพื่อตอบกลับหรือเริ่มบทสนทนา
                    </div>
                }
                else
                {
                    @foreach (var msg in Model.Messages)
                    {
                        <div class="chat-bubble-entry @(msg.IsMine ? "mine" : "theirs")">
                            <div class="entry-meta">
                                <span class="entry-sender-name">@msg.SenderName</span>
                                <span>@msg.TimeText</span>
                            </div>
                            <div class="@(msg.IsMine ? "entry-bubble-mine" : "entry-bubble-theirs")">
                                @msg.MessageText
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Input Bar -->
            <div class="admin-input-bar">
                <form id="adminChatForm" asp-controller="Account" asp-action="SendAdminChatMessage" method="post" class="admin-send-form">
                    <input type="hidden" name="channel" value="@Model.ActiveRoomId" />
                    <input type="text" name="message" id="adminInput" class="admin-text-field" 
                           placeholder="พิมพ์ข้อความตอบกลับถึง @Model.ActiveRoom.Name..." autocomplete="off" required />
                    <button type="submit" class="btn-send-gold">
                        <span>ส่งข้อความ</span>
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@{ var currentAdminName = Context.Session.GetString("UserName") ?? "ผู้ดูแลระบบสาขา (ผู้ดูแลระบบ)"; }
<script>
    (function () {
        const box = document.getElementById('adminMsgBox');
        const form = document.getElementById('adminChatForm');
        const input = document.getElementById('adminInput');
        const activeChannel = '@Model.ActiveRoomId';
        const myName = '@Html.Raw(currentAdminName.Replace("'", "\\'"))';

        function scrollToBottom() {
            if (box) box.scrollTop = box.scrollHeight;
        }
        scrollToBottom();

        // 1. AJAX Send Message (Instant, No page reload)
        if (form) {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const msgText = (input.value || '').trim();
                if (!msgText) return;

                const nowTime = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
                const tempDiv = document.createElement('div');
                tempDiv.className = 'chat-bubble-entry mine';
                tempDiv.innerHTML = `
                    <div class="entry-meta">
                        <span class="entry-sender-name">${escapeHtml(myName)}</span>
                        <span>${nowTime}</span>
                    </div>
                    <div class="entry-bubble-mine">${escapeHtml(msgText)}</div>
                `;

                if (box.querySelector('.fa-comment-dots')) box.innerHTML = '';
                box.appendChild(tempDiv);
                scrollToBottom();
                input.value = '';

                const fd = new FormData();
                fd.append('channel', activeChannel);
                fd.append('message', msgText);

                try {
                    await fetch('/Account/SendAdminMessageApi', { method: 'POST', body: fd });
                } catch (err) { }
            });
        }

        // 2. Real-time background polling (every 2.5s)
        let lastMsgCount = @Model.Messages.Count;
        setInterval(async function () {
            try {
                const res = await fetch(`/Account/GetAdminMessagesApi?channel=${encodeURIComponent(activeChannel)}`);
                if (!res.ok) return;
                const data = await res.json();
                if (data && data.success && Array.isArray(data.messages)) {
                    if (data.messages.length !== lastMsgCount) {
                        lastMsgCount = data.messages.length;
                        renderMessages(data.messages);
                    }
                }
            } catch (err) { }
        }, 2500);

        function renderMessages(msgs) {
            if (!box) return;
            if (!msgs.length) {
                box.innerHTML = `<div style="text-align: center; color: #777; margin-top: 60px;">
                    <i class="far fa-comment-dots" style="font-size: 36px; display: block; margin-bottom: 12px; color: #555;"></i>
                    ยังไม่มีข้อความ</div>`;
                return;
            }

            let html = '';
            msgs.forEach(m => {
                const cls = m.isMine ? 'mine' : 'theirs';
                const bubbleCls = m.isMine ? 'entry-bubble-mine' : 'entry-bubble-theirs';
                html += `
                    <div class="chat-bubble-entry ${cls}">
                        <div class="entry-meta">
                            <span class="entry-sender-name">${escapeHtml(m.senderName)}</span>
                            <span>${escapeHtml(m.timeText)}</span>
                        </div>
                        <div class="${bubbleCls}">${escapeHtml(m.messageText)}</div>
                    </div>`;
            });
            box.innerHTML = html;
            scrollToBottom();
        }

        function escapeHtml(t) {
            if (!t) return '';
            return t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    })();

    function filterRooms() {
        const query = (document.getElementById('adminSearchInput').value || '').toLowerCase().trim();
        const targets = document.querySelectorAll('.room-filter-target');
        targets.forEach(t => {
            const name = (t.getAttribute('data-name') || '').toLowerCase();
            t.style.display = name.includes(query) ? 'flex' : 'none';
        });
    }
</script>
