@model Kawin_67091861_002.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = "_LayoutAuth";
}

<section class="auth-hero">
    <div class="gold-line-top"></div>
    <div class="gold-line-bottom"></div>

    <div class="auth-card">
        <div class="auth-card-header">
            <span class="crown"><i class="fas fa-crown"></i></span>
            <div class="brand">ABSOLUTE CINEMA</div>
            <div class="subtitle">เข้าสู่ระบบสมาชิก</div>
        </div>

        @if (TempData["AuthNotice"] != null)
        {
            <div class="auth-error" style="background: rgba(223, 183, 108, 0.15); border: 1px solid #dfb76c; color: #fde68a;">
                <i class="fas fa-lock"></i>
                @TempData["AuthNotice"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="auth-error">
                <i class="fas fa-exclamation-circle"></i>
                @ViewBag.Error
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="Login" id="loginForm">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="form-group">
                <label asp-for="Email">อีเมลหรือชื่อผู้ใช้งาน</label>
                <div class="input-wrapper">
                    <input asp-for="Email" id="email" value="@Model.Email" placeholder="example@email.com" required />
                </div>
                <span asp-validation-for="Email" style="color: #ff6b6b; font-size: 13px; display: block; margin-top: 4px;"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">รหัสผ่าน</label>
                <div class="input-wrapper">
                    <input asp-for="Password" type="password" id="password" value="@Model.Password" placeholder="••••••••" required />
                    <span class="input-icon" onclick="togglePassword('password', this)">
                        <i class="fas fa-eye"></i>
                    </span>
                </div>
                <span asp-validation-for="Password" style="color: #ff6b6b; font-size: 13px; display: block; margin-top: 4px;"></span>
            </div>

            <div class="login-options">
                <div class="form-check">
                    <input asp-for="RememberMe" id="rememberMe" />
                    <label asp-for="RememberMe">จดจำฉัน</label>
                </div>
                <a href="#" class="forgot-password">ลืมรหัสผ่าน?</a>
            </div>

            <button type="submit" class="btn-submit">เข้าสู่ระบบ</button>
        </form>

        <div class="auth-switch">
            ยังไม่มีบัญชี? <a asp-controller="Account" asp-action="Register">สมัครสมาชิก</a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function togglePassword(inputId, iconEl) {
            const input = document.getElementById(inputId);
            const icon = iconEl.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // ระบบจดจำฉัน (Remember Me) ทำงานร่วมกันทั้ง Cookie และ LocalStorage ให้คงอยู่เสมอแม้กดออกจากระบบ
        document.addEventListener('DOMContentLoaded', function () {
            const emailInput = document.getElementById('email');
            const passwordInput = document.getElementById('password');
            const rememberMeCheckbox = document.getElementById('rememberMe');
            const loginForm = document.getElementById('loginForm');

            // 1. ตรวจสอบการจำข้อมูลจาก LocalStorage หากฟอร์มยังไม่ได้ค่าจาก Cookie
            const savedRemember = localStorage.getItem('abs_cinema_remember_me');
            if (savedRemember === 'true') {
                rememberMeCheckbox.checked = true;
                if (!emailInput.value) {
                    const savedEmail = localStorage.getItem('abs_cinema_remember_email');
                    if (savedEmail) emailInput.value = savedEmail;
                }
                if (!passwordInput.value) {
                    const savedPass = localStorage.getItem('abs_cinema_remember_password');
                    if (savedPass) passwordInput.value = savedPass;
                }
            }

            // 2. บันทึกหรือลบข้อมูลเมื่อกดปุ่มเข้าสู่ระบบ
            if (loginForm) {
                loginForm.addEventListener('submit', function () {
                    if (rememberMeCheckbox.checked) {
                        localStorage.setItem('abs_cinema_remember_me', 'true');
                        localStorage.setItem('abs_cinema_remember_email', emailInput.value || '');
                        localStorage.setItem('abs_cinema_remember_password', passwordInput.value || '');
                    } else {
                        localStorage.removeItem('abs_cinema_remember_me');
                        localStorage.removeItem('abs_cinema_remember_email');
                        localStorage.removeItem('abs_cinema_remember_password');
                    }
                });
            }
        });
    </script>
}
