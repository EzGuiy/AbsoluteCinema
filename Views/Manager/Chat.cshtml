@model Kawin_67091861_002.ViewModels.ManagerChatViewModel
@{
    Layout = "_LayoutManager";
    ViewData["Title"] = "แชทและการสื่อสารภายใน";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.5px;
        margin: 0;
    }

    .page-subtitle {
        font-size: 13px;
        color: #8c8c9e;
        margin-top: 4px;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search-input-box {
        position: relative;
        min-width: 240px;
    }

    .search-input-box input {
        width: 100%;
        background: #141419;
        border: 1px solid #23232c;
        border-radius: 8px;
        padding: 8px 12px 8px 36px;
        font-size: 13px;
        color: #fff;
    }

    .search-input-box input:focus {
        outline: none;
        border-color: #f59e0b;
    }

    .search-input-box i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #656575;
        font-size: 13px;
    }

    .icon-circle-btn {
        width: 38px;
        height: 38px;
        background: #141419;
        border: 1px solid #23232c;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9292a0;
        cursor: pointer;
        transition: 0.2s;
    }

    /* Chat 2-Column Layout */
    .chat-container-grid {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 20px;
        height: calc(100vh - 200px);
        min-height: 600px;
    }

    /* Left Channel List */
    .channels-list-card {
        background: #141419;
        border: 1px solid #22222b;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .channels-header {
        padding: 16px 20px;
        border-bottom: 1px solid #22222b;
        font-size: 12px;
        font-weight: 700;
        color: #656575;
        letter-spacing: 0.5px;
    }

    .channel-items-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .channel-item-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 10px;
        text-decoration: none;
        color: #d1d1dc;
        border: 1px solid transparent;
        transition: all 0.2s;
    }

    .channel-item-link:hover {
        background: #1a1a24;
        color: #fff;
    }

    .channel-item-link.active {
        background: #1f1f2a;
        border-color: #323244;
        color: #ffffff;
    }

    .channel-avatar {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .avatar-gold { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .avatar-blue { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); }
    .avatar-green { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
    .avatar-brown { background: rgba(217, 119, 6, 0.15); color: #f59e0b; border: 1px solid rgba(217, 119, 6, 0.3); }

    .channel-info-col {
        flex: 1;
        min-width: 0;
    }

    .channel-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2px;
    }

    .channel-name {
        font-size: 13.5px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .channel-last-msg {
        font-size: 11.5px;
        color: #727284;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .badge-unread-red {
        background: #ef4444;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        padding: 1px 7px;
        border-radius: 10px;
    }

    /* Right Conversation Area */
    .conversation-card {
        background: #141419;
        border: 1px solid #22222b;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .conv-header {
        padding: 16px 24px;
        border-bottom: 1px solid #22222b;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .conv-title {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
    }

    .conv-sub {
        font-size: 11.5px;
        color: #727284;
        margin-top: 2px;
    }

    .pinned-banner {
        background: #181822;
        border-bottom: 1px solid #22222b;
        padding: 9px 24px;
        font-size: 12px;
        color: #d1d1dc;
        display: flex;
        align-items: center;
    }

    .messages-stream-box {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .msg-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
        max-width: 82%;
    }

    .msg-item.theirs {
        align-self: flex-start;
    }

    .msg-item.mine {
        align-self: flex-end;
    }

    .msg-meta-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
    }

    .msg-sender {
        font-weight: 700;
        color: #ffffff;
    }

    .msg-time {
        color: #656575;
    }

    .msg-bubble-theirs {
        background: #1a1a24;
        border: 1px solid #282836;
        border-radius: 10px;
        padding: 12px 16px;
        color: #d1d1dc;
        font-size: 13.5px;
        line-height: 1.5;
    }

    .msg-bubble-mine {
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.35);
        border-radius: 10px;
        padding: 12px 16px;
        color: #fde68a;
        font-size: 13.5px;
        line-height: 1.5;
    }

    /* Input Footer */
    .conv-input-footer {
        padding: 16px 24px;
        border-top: 1px solid #22222b;
        background: #111116;
    }

    .chat-input-form {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .chat-input-field {
        flex: 1;
        background: #181820;
        border: 1px solid #282836;
        border-radius: 8px;
        padding: 10px 16px;
        font-size: 13.5px;
        color: #fff;
    }

    .chat-input-field:focus {
        outline: none;
        border-color: #f59e0b;
    }

    .btn-send-gold {
        background: #f59e0b;
        color: #000;
        font-weight: 700;
        font-size: 13px;
        padding: 10px 20px;
        border-radius: 8px;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-send-gold:hover {
        background: #fbbf24;
    }
</style>

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">แชทและการสื่อสารภายใน</h1>
        <div class="page-subtitle">ศูนย์กลางประสานงานด่วนระหว่างผู้จัดการกับฝ่ายต่างๆ ในโรงภาพยนตร์</div>
    </div>
    <div class="header-actions">
        <div class="search-input-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="ค้นหาข้อความหรือชื่อเจ้าหน้าที่..." />
        </div>
        <div class="icon-circle-btn">
            <i class="bi bi-bell"></i>
        </div>
    </div>
</div>

<!-- 2-Column Chat Layout -->
<div class="chat-container-grid">
    <!-- Channels List -->
    <div class="channels-list-card">
        <div class="channels-header">กลุ่มการสื่อสาร (CHANNELS)</div>
        <div class="channel-items-scroll">
            @foreach (var room in Model.Rooms)
            {
                string avatarClass = room.ColorType switch
                {
                    "gold" => "avatar-gold",
                    "blue" => "avatar-blue",
                    "green" => "avatar-green",
                    "brown" => "avatar-brown",
                    _ => "avatar-gold"
                };

                <a asp-controller="Manager" asp-action="Chat" asp-route-channel="@room.Id" 
                   class="channel-item-link @(room.IsActive ? "active" : "")">
                    <div class="channel-avatar @avatarClass">
                        <i class="bi bi-hash"></i>
                    </div>
                    <div class="channel-info-col">
                        <div class="channel-title-row">
                            <span class="channel-name">@room.Name</span>
                            @if (room.UnreadCount > 0)
                            {
                                <span class="badge-unread-red">@room.UnreadCount</span>
                            }
                        </div>
                        <div class="channel-last-msg">@room.LastMessageText</div>
                    </div>
                </a>
            }
        </div>
    </div>

    <!-- Active Channel Conversation -->
    <div class="conversation-card">
        <div class="conv-header">
            <div>
                <div class="conv-title">
                    <i class="bi bi-hash" style="color: #f59e0b;"></i> @Model.ActiveRoom.Name
                </div>
                <div class="conv-sub">@Model.ActiveRoom.MembersInfo</div>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <div class="icon-circle-btn" title="ค้นหาในห้องนี้"><i class="bi bi-search"></i></div>
                <div class="icon-circle-btn" title="ข้อมูลห้อง"><i class="bi bi-info-circle"></i></div>
            </div>
        </div>

        <div class="pinned-banner">
            <i class="bi bi-pin-angle-fill me-2" style="color: #f59e0b;"></i>
            <span>ปักหมุด: กรุณาแจ้งสรุปข้อผิดพลาดหรือรอบฉายฉุกเฉินในห้องนี้โดยด่วนเพื่อการประสานงานที่มีประสิทธิภาพ</span>
        </div>

        <div class="messages-stream-box" id="messagesBox">
            @if (!Model.Messages.Any())
            {
                <div style="text-align: center; color: #656575; margin-top: 40px;">
                    <i class="bi bi-chat-dots" style="font-size: 32px; display: block; margin-bottom: 8px;"></i>
                    ยังไม่มีข้อความในห้องนี้ เริ่มต้นส่งข้อความแรกได้เลย
                </div>
            }
            else
            {
                @foreach (var msg in Model.Messages)
                {
                    <div class="msg-item @(msg.IsMine ? "mine" : "theirs")">
                        <div class="msg-meta-row" style="@(msg.IsMine ? "justify-content: flex-end;" : "")">
                            <span class="msg-sender">@msg.SenderName</span>
                            <span class="msg-time">@msg.TimeText</span>
                        </div>
                        <div class="@(msg.IsMine ? "msg-bubble-mine" : "msg-bubble-theirs")">
                            @msg.MessageText
                        </div>
                    </div>
                }
            }
        </div>

        <div class="conv-input-footer">
            <form asp-controller="Manager" asp-action="SendManagerChatMessage" method="post" class="chat-input-form">
                <input type="hidden" name="channel" value="@Model.ActiveRoomId" />
                <input type="text" name="message" class="chat-input-field" placeholder="พิมพ์ข้อความถึง@Model.ActiveRoom.Name..." autocomplete="off" required />
                <button type="submit" class="btn-send-gold">
                    <span>ส่ง</span>
                    <i class="bi bi-send-fill"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', function () {
        var box = document.getElementById('messagesBox');
        if (box) {
            box.scrollTop = box.scrollHeight;
        }
    });
</script>
