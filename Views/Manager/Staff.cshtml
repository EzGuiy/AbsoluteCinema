@model Kawin_67091861_002.ViewModels.ManagerStaffViewModel
@{
    Layout = "_LayoutManager";
    ViewData["Title"] = "พนักงานและสิทธิ์การเข้าถึง";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.5px;
        margin: 0;
    }

    .page-subtitle {
        font-size: 13px;
        color: #8c8c9e;
        margin-top: 4px;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search-input-box {
        position: relative;
        min-width: 240px;
    }

    .search-input-box input {
        width: 100%;
        background: #141419;
        border: 1px solid #23232c;
        border-radius: 8px;
        padding: 8px 12px 8px 36px;
        font-size: 13px;
        color: #fff;
    }

    .search-input-box input:focus {
        outline: none;
        border-color: #f59e0b;
    }

    .search-input-box i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #656575;
        font-size: 13px;
    }

    .icon-circle-btn {
        width: 38px;
        height: 38px;
        background: #141419;
        border: 1px solid #23232c;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9292a0;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-gold {
        background: #f59e0b;
        color: #000000;
        font-weight: 700;
        font-size: 13px;
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-gold:hover {
        background: #fbbf24;
        color: #000000;
    }

    /* Summary Badges Row */
    .summary-badges-bar {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .badge-status-counter {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .badge-counter-green {
        background: rgba(34, 197, 94, 0.12);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.25);
    }

    .badge-counter-amber {
        background: rgba(245, 158, 11, 0.12);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.25);
    }

    /* Staff Table Card */
    .staff-table-card {
        background: #141419;
        border: 1px solid #22222b;
        border-radius: 12px;
        overflow: hidden;
    }

    .table-mgr-staff {
        width: 100%;
        border-collapse: collapse;
    }

    .table-mgr-staff th {
        padding: 14px 24px;
        font-size: 12px;
        font-weight: 600;
        color: #656575;
        border-bottom: 1px solid #22222b;
        text-align: left;
    }

    .table-mgr-staff td {
        padding: 16px 24px;
        font-size: 13px;
        color: #d1d1dc;
        border-bottom: 1px solid #1c1c24;
        vertical-align: middle;
    }

    .table-mgr-staff tr:last-child td {
        border-bottom: none;
    }

    .table-mgr-staff tr:hover td {
        background: #171720;
    }

    .staff-name-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .staff-avatar-circle {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #20202c;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e2e8f0;
        font-weight: 700;
        font-size: 12px;
    }

    .staff-name-title {
        font-weight: 700;
        color: #ffffff;
        font-size: 13.5px;
    }

    .role-text-highlight {
        color: #fbbf24;
        font-weight: 500;
    }

    .status-pill-staff {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-duty {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }

    .status-leave {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .btn-action-icon {
        background: transparent;
        border: 1px solid #282834;
        color: #9292a0;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-action-icon:hover {
        border-color: #f59e0b;
        color: #f59e0b;
    }
</style>

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">พนักงานและสิทธิ์การเข้าถึง</h1>
        <div class="page-subtitle">จัดการรายชื่อ เวรการทำงาน และระดับสิทธิ์ของเจ้าหน้าที่ในสาขา</div>
    </div>
    <div class="header-actions">
        <div class="search-input-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="ค้นหารายการ..." />
        </div>
        <div class="icon-circle-btn">
            <i class="bi bi-bell"></i>
        </div>
        <button class="btn-gold" data-bs-toggle="modal" data-bs-target="#createStaffModal">
            <i class="bi bi-plus-lg"></i>
            <span>เพิ่มพนักงานใหม่</span>
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="background: rgba(34, 197, 94, 0.15); border: 1px solid #22c55e; color: #4ade80; border-radius: 10px;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Summary Badges -->
<div class="summary-badges-bar">
    <div class="badge-status-counter badge-counter-green">
        <i class="bi bi-circle-fill" style="font-size: 8px;"></i>
        <span>ปฏิบัติงาน (On-duty) @Model.OnDutyCount คน</span>
    </div>
    <div class="badge-status-counter badge-counter-amber">
        <i class="bi bi-circle-fill" style="font-size: 8px;"></i>
        <span>ลางาน / เวรต่อไป @Model.OnLeaveCount คน</span>
    </div>
</div>

<!-- Staff Table -->
<div class="staff-table-card">
    <div class="table-responsive">
        <table class="table-mgr-staff">
            <thead>
                <tr>
                    <th style="width: 26%;">ชื่อ-นามสกุล</th>
                    <th style="width: 24%;">ตำแหน่ง / แผนก</th>
                    <th style="width: 20%;">กะการทำงาน</th>
                    <th style="width: 14%;">ระดับสิทธิ์</th>
                    <th style="width: 12%;">สถานะ</th>
                    <th style="text-align: right; width: 4%;">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.StaffList)
                {
                    bool isOnDuty = s.Status.Contains("ปฏิบัติงาน");
                    string initial = string.IsNullOrEmpty(s.Name) ? "พ" : s.Name.Substring(0, 1);

                    <tr>
                        <td>
                            <div class="staff-name-wrap">
                                <div class="staff-avatar-circle">@initial</div>
                                <div class="staff-name-title">@s.Name</div>
                            </div>
                        </td>
                        <td>
                            <div class="role-text-highlight">@s.RoleTitle</div>
                        </td>
                        <td>
                            <span style="color: #94a3b8; font-size: 12.5px;"><i class="bi bi-clock me-1"></i>@s.ShiftText</span>
                        </td>
                        <td>
                            <span style="color: #cbd5e1;">@s.AccessLevel</span>
                        </td>
                        <td>
                            <span class="status-pill-staff @(isOnDuty ? "status-duty" : "status-leave")">
                                <i class="bi bi-circle-fill" style="font-size: 6px;"></i>
                                @s.Status
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <form asp-controller="Manager" asp-action="ToggleStaffStatus" method="post" style="display: inline;">
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn-action-icon" title="สลับสถานะ ปฏิบัติงาน / ลางาน">
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal เพิ่มพนักงานใหม่ -->
<div class="modal fade" id="createStaffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #18181f; border: 1px solid #2a2a38; border-radius: 12px; color: #fff;">
            <div class="modal-header" style="border-bottom: 1px solid #2a2a38; padding: 18px 24px;">
                <h5 class="modal-title" style="font-weight: 700; font-size: 16px;">
                    <i class="bi bi-person-plus-fill me-2" style="color: #f59e0b;"></i>เพิ่มพนักงานใหม่ประจำสาขา
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Manager" asp-action="CreateStaffMember" method="post">
                <div class="modal-body" style="padding: 20px 24px; display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <label style="font-size: 12.5px; color: #9292a0; margin-bottom: 6px;">ชื่อ-นามสกุล</label>
                        <input type="text" name="Name" class="form-control" placeholder="เช่น รัชชานนท์ ชื่นจิตต์" required style="background: #111116; border: 1px solid #282836; color: #fff; border-radius: 8px;" />
                    </div>
                    <div>
                        <label style="font-size: 12.5px; color: #9292a0; margin-bottom: 6px;">ตำแหน่ง / แผนก</label>
                        <select name="RoleTitle" class="form-select" style="background: #111116; border: 1px solid #282836; color: #fff; border-radius: 8px;">
                            <option value="พนักงานขายตั๋ว (Box Office)">พนักงานขายตั๋ว (Box Office)</option>
                            <option value="พนักงานบริการและเครื่องดื่ม">พนักงานบริการและเครื่องดื่ม (Concessions)</option>
                            <option value="พนักงานตรวจโรงภาพยนตร์">พนักงานตรวจโรงภาพยนตร์ (Floor Staff)</option>
                            <option value="ช่างเสียงและระบบภาพ">ช่างเสียงและระบบภาพ (AV Technician)</option>
                            <option value="วิศวกรห้องควบคุมและเครื่องฉาย">วิศวกรห้องควบคุมและเครื่องฉาย (Projectionist)</option>
                            <option value="หัวหน้างานฝ่ายตั๋วและบริการ">หัวหน้างานฝ่ายตั๋วและบริการ (Supervisor)</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 12.5px; color: #9292a0; margin-bottom: 6px;">กะการทำงาน</label>
                        <select name="ShiftText" class="form-select" style="background: #111116; border: 1px solid #282836; color: #fff; border-radius: 8px;">
                            <option value="เวรเช้า (08:00 - 16:00)" selected>เวรเช้า (08:00 - 16:00)</option>
                            <option value="เวรบ่าย (14:00 - 22:00)">เวรบ่าย (14:00 - 22:00)</option>
                            <option value="เวรดึก (20:00 - 04:00)">เวรดึก (20:00 - 04:00)</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 12.5px; color: #9292a0; margin-bottom: 6px;">ระดับสิทธิ์การเข้าถึง</label>
                        <select name="AccessLevel" class="form-select" style="background: #111116; border: 1px solid #282836; color: #fff; border-radius: 8px;">
                            <option value="ระดับเริ่มต้น" selected>ระดับเริ่มต้น (Staff Access)</option>
                            <option value="สิทธิ์เทคนิค">สิทธิ์เทคนิค (Technical Access)</option>
                            <option value="สิทธิ์เทคนิคเต็มขั้น">สิทธิ์เทคนิคเต็มขั้น (Full Tech / Projector)</option>
                            <option value="ผู้ดูแลระดับกลาง">ผู้ดูแลระดับกลาง (Supervisor Access)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #2a2a38; padding: 16px 24px;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 8px; font-size: 13px;">ยกเลิก</button>
                    <button type="submit" class="btn-gold">บันทึกพนักงาน</button>
                </div>
            </form>
        </div>
    </div>
</div>
