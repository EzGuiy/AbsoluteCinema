@model Kawin_67091861_002.ViewModels.ManagerPromotionsViewModel
@{
    Layout = "_LayoutManager";
    ViewData["Title"] = "โปรโมชั่นและส่วนลด";
}

<style>
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.5px;
        margin: 0;
    }

    .page-subtitle {
        font-size: 13px;
        color: #8c8c9e;
        margin-top: 4px;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search-input-box {
        position: relative;
        min-width: 240px;
    }

    .search-input-box input {
        width: 100%;
        background: #141419;
        border: 1px solid #23232c;
        border-radius: 8px;
        padding: 8px 12px 8px 36px;
        font-size: 13px;
        color: #fff;
    }

    .search-input-box input:focus {
        outline: none;
        border-color: #f59e0b;
    }

    .search-input-box i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #656575;
        font-size: 13px;
    }

    .icon-circle-btn {
        width: 38px;
        height: 38px;
        background: #141419;
        border: 1px solid #23232c;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9292a0;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-gold {
        background: #f59e0b;
        color: #000000;
        font-weight: 700;
        font-size: 13px;
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-gold:hover {
        background: #fbbf24;
        color: #000000;
    }

    /* Hot Promo Hero Card */
    .hero-promo-card {
        background: linear-gradient(135deg, #a66a2c 0%, #613915 50%, #2f1d0b 100%);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 14px;
        padding: 26px 30px;
        margin-bottom: 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        position: relative;
        overflow: hidden;
    }

    .hero-promo-left {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-width: 720px;
    }

    .hero-tag {
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 1px;
        color: #fde68a;
        text-transform: uppercase;
        background: rgba(0, 0, 0, 0.25);
        padding: 3px 10px;
        border-radius: 6px;
        display: inline-block;
        width: fit-content;
    }

    .hero-title {
        font-size: 22px;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.3px;
    }

    .hero-desc {
        font-size: 13.5px;
        color: #fed7aa;
        line-height: 1.5;
    }

    .hero-footer-text {
        font-size: 11.5px;
        color: #d1b18a;
        margin-top: 4px;
    }

    .btn-hero-edit {
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        padding: 9px 18px;
        border-radius: 8px;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-hero-edit:hover {
        background: rgba(0, 0, 0, 0.6);
        color: #fbbf24;
    }

    /* Promotions Table Card */
    .promo-table-card {
        background: #141419;
        border: 1px solid #22222b;
        border-radius: 12px;
        overflow: hidden;
    }

    .table-title-bar {
        padding: 18px 24px;
        border-bottom: 1px solid #22222b;
        font-size: 15px;
        font-weight: 700;
        color: #ffffff;
    }

    .table-mgr-promo {
        width: 100%;
        border-collapse: collapse;
    }

    .table-mgr-promo th {
        padding: 14px 24px;
        font-size: 12px;
        font-weight: 600;
        color: #656575;
        border-bottom: 1px solid #22222b;
        text-align: left;
    }

    .table-mgr-promo td {
        padding: 16px 24px;
        font-size: 13px;
        color: #d1d1dc;
        border-bottom: 1px solid #1c1c24;
        vertical-align: middle;
    }

    .table-mgr-promo tr:last-child td {
        border-bottom: none;
    }

    .table-mgr-promo tr:hover td {
        background: #171720;
    }

    .promo-main-title {
        font-weight: 700;
        color: #ffffff;
        font-size: 13.5px;
    }

    .promo-sub-desc {
        font-size: 11.5px;
        color: #727284;
        margin-top: 2px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-active {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }

    .status-expired {
        background: rgba(148, 163, 184, 0.15);
        color: #94a3b8;
        border: 1px solid rgba(148, 163, 184, 0.3);
    }

    .status-draft {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .btn-action-icon {
        background: transparent;
        border: 1px solid #282834;
        color: #9292a0;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-action-icon:hover {
        border-color: #f59e0b;
        color: #f59e0b;
    }
</style>

<!-- Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">โปรโมชั่นและส่วนลด</h1>
        <div class="page-subtitle">บริหารแคมเปญการตลาด คูปอง และส่วนลดสำหรับโรงภาพยนตร์ทุกสาขา</div>
    </div>
    <div class="header-actions">
        <div class="search-input-box">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="ค้นหารายการ..." />
        </div>
        <div class="icon-circle-btn">
            <i class="bi bi-bell"></i>
        </div>
        <button class="btn-gold" data-bs-toggle="modal" data-bs-target="#createPromoModal">
            <i class="bi bi-plus-lg"></i>
            <span>สร้างโปรโมชั่นใหม่</span>
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="background: rgba(34, 197, 94, 0.15); border: 1px solid #22c55e; color: #4ade80; border-radius: 10px;">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Hero Campaign Banner -->
<div class="hero-promo-card">
    <div class="hero-promo-left">
        <div class="hero-tag">WEEKDAY SPECIAL</div>
        <div class="hero-title">@Model.HotTitle</div>
        <div class="hero-desc">@Model.HotDesc</div>
        <div class="hero-footer-text"><i class="bi bi-info-circle me-1"></i> @Model.HotSub</div>
    </div>
    <div>
        <button class="btn-hero-edit" data-bs-toggle="modal" data-bs-target="#createPromoModal">
            <i class="bi bi-sliders me-1"></i> แก้ไขแคมเปญ
        </button>
    </div>
</div>

<!-- All Promotions Table -->
<div class="promo-table-card">
    <div class="table-title-bar">
        รายการโปรโมชั่นทั้งหมด (@Model.Promotions.Count รายการ)
    </div>
    <div class="table-responsive">
        <table class="table-mgr-promo">
            <thead>
                <tr>
                    <th style="width: 32%;">ชื่อโปรโมชั่น</th>
                    <th style="width: 18%;">ประเภทส่วนลด</th>
                    <th style="width: 20%;">ระยะเวลา</th>
                    <th style="width: 14%;">จำนวนการใช้งาน</th>
                    <th style="width: 16%;">สถานะ</th>
                    <th style="text-align: right; width: 10%;">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var promo in Model.Promotions)
                {
                    string statusClass = promo.Status switch
                    {
                        "กำลังใช้งาน" => "status-active",
                        "หมดอายุแล้ว" => "status-expired",
                        _ => "status-draft"
                    };

                    <tr>
                        <td>
                            <div class="promo-main-title">@promo.Title</div>
                            <div class="promo-sub-desc">@promo.Description</div>
                        </td>
                        <td>
                            <span style="color: #cbd5e1;">@promo.DiscountType</span>
                        </td>
                        <td>
                            <span style="color: #94a3b8; font-size: 12px;"><i class="bi bi-clock me-1"></i>@promo.DurationText</span>
                        </td>
                        <td>
                            <span style="font-weight: 600; color: #f59e0b;">@promo.UsageCountText</span>
                        </td>
                        <td>
                            <span class="status-pill @statusClass">
                                <i class="bi bi-circle-fill" style="font-size: 6px;"></i>
                                @promo.Status
                            </span>
                        </td>
                        <td style="text-align: right;">
                            <form asp-controller="Manager" asp-action="TogglePromotionStatus" method="post" style="display: inline;">
                                <input type="hidden" name="id" value="@promo.Id" />
                                <button type="submit" class="btn-action-icon" title="เปิด/ปิด การใช้งานโปรโมชั่น">
                                    <i class="bi bi-power"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal สร้างโปรโมชั่นใหม่ -->
<div class="modal fade" id="createPromoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #18181f; border: 1px solid #2a2a38; border-radius: 12px; color: #fff;">
            <div class="modal-header" style="border-bottom: 1px solid #2a2a38; padding: 18px 24px;">
                <h5 class="modal-title" style="font-weight: 700; font-size: 16px;">
                    <i class="bi bi-tag-fill me-2" style="color: #f59e0b;"></i>สร้างแคมเปญโปรโมชั่นใหม่
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Manager" asp-action="CreatePromotion" method="post">
                <div class="modal-body" style="padding: 20px 24px; display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <label style="font-size: 12.5px; color: #9292a0; margin-bottom: 6px;">ชื่อโปรโมชั่น / แคมเปญ</label>
                        <input type="text" name="Title" class="form-control" placeholder="เช่น Flash Sale วันหยุด ฿150" required style="background: #111116; border: 1px solid #282836; color: #fff; border-radius: 8px;" />
                    </div>
                    <div>
                        <label style="font-size: 12.5px; color: #9292a0; margin-bottom: 6px;">คำอธิบายเงื่อนไข</label>
                        <input type="text" name="Description" class="form-control" placeholder="เช่น สำหรับรอบฉายก่อนเที่ยง เสาร์-อาทิตย์" style="background: #111116; border: 1px solid #282836; color: #fff; border-radius: 8px;" />
                    </div>
                    <div>
                        <label style="font-size: 12.5px; color: #9292a0; margin-bottom: 6px;">ประเภทส่วนลด</label>
                        <select name="DiscountType" class="form-select" style="background: #111116; border: 1px solid #282836; color: #fff; border-radius: 8px;">
                            <option value="ส่วนลดราคาตั๋ว">ส่วนลดราคาตั๋ว</option>
                            <option value="ส่วนลด F&B">ส่วนลด F&B (ป๊อปคอร์นและเครื่องดื่ม)</option>
                            <option value="อัปเกรดที่นั่ง">อัปเกรดที่นั่ง</option>
                            <option value="แพ็กเกจครอบครัว">แพ็กเกจครอบครัว / กลุ่ม</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size: 12.5px; color: #9292a0; margin-bottom: 6px;">ระยะเวลาการใช้งาน</label>
                        <input type="text" name="DurationText" value="1 ต.ค. - 31 ธ.ค. 69" class="form-control" style="background: #111116; border: 1px solid #282836; color: #fff; border-radius: 8px;" />
                    </div>
                    <div>
                        <label style="font-size: 12.5px; color: #9292a0; margin-bottom: 6px;">สถานะเริ่มต้น</label>
                        <select name="Status" class="form-select" style="background: #111116; border: 1px solid #282836; color: #fff; border-radius: 8px;">
                            <option value="กำลังใช้งาน" selected>กำลังใช้งาน (Active)</option>
                            <option value="ฉบับร่าง">ฉบับร่าง (Draft)</option>
                            <option value="หมดอายุแล้ว">หมดอายุแล้ว (Expired)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid #2a2a38; padding: 16px 24px;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" style="border-radius: 8px; font-size: 13px;">ยกเลิก</button>
                    <button type="submit" class="btn-gold">บันทึกโปรโมชั่น</button>
                </div>
            </form>
        </div>
    </div>
</div>
