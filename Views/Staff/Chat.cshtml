@model Kawin_67091861_002.ViewModels.ManagerChatViewModel
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "แชทและการสื่อสารฝ่ายบริการ";
}

<style>
    .staff-chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .staff-chat-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
    }

    .staff-chat-sub {
        font-size: 13px;
        color: var(--text-secondary);
        margin-top: 4px;
    }

    .chat-grid-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        height: calc(100vh - 200px);
        min-height: 580px;
    }

    /* Channels List */
    .channels-panel {
        background: var(--bg-card);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .channels-head {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-card);
        font-size: 12px;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 0.5px;
    }

    .channels-body {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .room-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 10px;
        text-decoration: none;
        color: var(--text-secondary);
        border: 1px solid transparent;
        transition: all 0.2s;
    }

    .room-link:hover {
        background: var(--bg-card-subtle);
        color: #ffffff;
    }

    .room-link.active {
        background: rgba(14, 165, 233, 0.12);
        border-color: rgba(14, 165, 233, 0.4);
        color: #ffffff;
    }

    .room-avatar {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        flex-shrink: 0;
        background: rgba(14, 165, 233, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(14, 165, 233, 0.3);
    }

    .room-info {
        flex: 1;
        min-width: 0;
    }

    .room-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2px;
    }

    .room-name {
        font-size: 13.5px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .room-msg-preview {
        font-size: 11.5px;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Conversation */
    .conversation-panel {
        background: var(--bg-card);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .conv-top-bar {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-card);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .conv-head-title {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
    }

    .conv-head-sub {
        font-size: 11.5px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .conv-stream {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .chat-bubble-wrap {
        display: flex;
        flex-direction: column;
        gap: 4px;
        max-width: 80%;
    }

    .chat-bubble-wrap.theirs {
        align-self: flex-start;
    }

    .chat-bubble-wrap.mine {
        align-self: flex-end;
    }

    .chat-meta {
        font-size: 11px;
        color: var(--text-muted);
        display: flex;
        gap: 8px;
    }

    .chat-bubble {
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13.5px;
        line-height: 1.5;
    }

    .chat-bubble-wrap.theirs .chat-bubble {
        background: #172130;
        border: 1px solid var(--border-card);
        color: #e2e8f0;
    }

    .chat-bubble-wrap.mine .chat-bubble {
        background: rgba(14, 165, 233, 0.15);
        border: 1px solid rgba(14, 165, 233, 0.4);
        color: #e0f2fe;
    }

    .chat-input-bar {
        padding: 16px 24px;
        border-top: 1px solid var(--border-card);
        background: #0e131b;
    }

    .chat-send-form {
        display: flex;
        gap: 12px;
    }

    .chat-send-input {
        flex: 1;
        background: #121924;
        border: 1px solid var(--border-card);
        color: #fff;
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 13.5px;
    }

    .chat-send-input:focus {
        outline: none;
        border-color: #0ea5e9;
    }

    .btn-send-cyan {
        background: #0ea5e9;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
    }

    .btn-send-cyan:hover {
        background: #0284c7;
    }
</style>

<div class="staff-chat-header">
    <div>
        <h1 class="staff-chat-title">แชททีมงานรวมทุกแผนก</h1>
        <div class="staff-chat-sub">ห้องสนทนารวมสำหรับทุกคนในสาขา (ผู้จัดการ, พนักงานบริการ, ช่างเทคนิค, บัญชี, แอดมิน)</div>
    </div>
</div>

<div class="chat-grid-layout">
    <!-- Active Conversation (Group Only) -->
    <div class="conversation-panel">
        <div class="conv-top-bar">
            <div class="d-flex align-items-center gap-3">
                <div class="room-avatar" style="width:36px; height:36px; font-size:15px; background:rgba(14,165,233,0.15); color:#38bdf8; border-color:rgba(14,165,233,0.3);">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="conv-head-title">@Model.ActiveRoom.Name</div>
                    <div class="conv-head-sub">@Model.ActiveRoom.MembersInfo</div>
                </div>
            </div>
        </div>

        <div class="conv-stream" id="staffMsgBox">
            @if (!Model.Messages.Any())
            {
                <div style="text-align: center; color: var(--text-muted); margin-top: 40px;">
                    <i class="bi bi-chat-dots" style="font-size: 32px; display: block; margin-bottom: 8px;"></i>
                    ยังไม่มีข้อความในห้องนี้ เริ่มต้นส่งข้อความแรกได้เลย
                </div>
            }
            else
            {
                @foreach (var msg in Model.Messages)
                {
                    <div class="chat-bubble-wrap @(msg.IsMine ? "mine" : "theirs")">
                        <div class="chat-meta" style="@(msg.IsMine ? "justify-content: flex-end;" : "")">
                            <span style="font-weight: 700; color: #ffffff;">@msg.SenderName</span>
                            <span>@msg.TimeText</span>
                        </div>
                        <div class="chat-bubble">
                            @msg.MessageText
                        </div>
                    </div>
                }
            }
        </div>

        <div class="chat-input-bar">
            <form asp-controller="Staff" asp-action="SendStaffChatMessage" method="post" class="chat-send-form">
                <input type="hidden" name="channel" value="@Model.ActiveRoomId" />
                <input type="text" name="message" class="chat-send-input" placeholder="พิมพ์ข้อความ..." autocomplete="off" required />
                <button type="submit" class="btn-send-cyan">
                    <span>ส่ง</span>
                    <i class="bi bi-send-fill"></i>
                </button>
            </form>
        </div>
    </div>
</div>

@{ var currentUserName = Context.Session.GetString("UserName") ?? "พนักงาน"; }
<script>
    (function () {
        const box = document.getElementById('staffMsgBox');
        const form = document.querySelector('.chat-send-form');
        const input = document.querySelector('.chat-send-input');
        const channelInput = form ? form.querySelector('input[name="channel"]') : null;
        const activeChannel = channelInput ? channelInput.value : 'group';
        const myName = '@Html.Raw(currentUserName.Replace("'", "\\'"))';

        function scrollToBottom() {
            if (box) box.scrollTop = box.scrollHeight;
        }
        scrollToBottom();

        if (form) {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const msgText = (input.value || '').trim();
                if (!msgText) return;

                const nowTime = new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' });
                const tempDiv = document.createElement('div');
                tempDiv.className = 'chat-bubble-wrap mine';
                tempDiv.innerHTML = `
                    <div class="chat-meta" style="justify-content: flex-end;">
                        <span style="font-weight: 700; color: #ffffff;">${escapeHtml(myName)}</span>
                        <span>${nowTime}</span>
                    </div>
                    <div class="chat-bubble">${escapeHtml(msgText)}</div>
                `;

                if (box.querySelector('.bi-chat-dots')) box.innerHTML = '';
                box.appendChild(tempDiv);
                scrollToBottom();
                input.value = '';

                const fd = new FormData();
                fd.append('channel', activeChannel);
                fd.append('message', msgText);

                try {
                    await fetch('/Staff/SendMessageApi', { method: 'POST', body: fd });
                } catch (err) { console.error('Send error:', err); }
            });
        }

        let lastMsgCount = @Model.Messages.Count;
        setInterval(async function () {
            try {
                const res = await fetch(`/Staff/GetMessagesApi?channel=${encodeURIComponent(activeChannel)}`);
                if (!res.ok) return;
                const data = await res.json();
                if (data && data.success && Array.isArray(data.messages)) {
                    if (data.messages.length !== lastMsgCount) {
                        lastMsgCount = data.messages.length;
                        renderMessages(data.messages);
                    }
                }
            } catch (err) { }
        }, 2500);

        function renderMessages(msgs) {
            if (!box) return;
            if (!msgs.length) {
                box.innerHTML = `<div style="text-align: center; color: var(--text-muted); margin-top: 40px;">
                    <i class="bi bi-chat-dots" style="font-size: 32px; display: block; margin-bottom: 8px;"></i>
                    ยังไม่มีข้อความในห้องนี้</div>`;
                return;
            }
            let html = '';
            msgs.forEach(m => {
                const mineClass = m.isMine ? 'mine' : 'theirs';
                const metaAlign = m.isMine ? 'justify-content: flex-end;' : '';
                html += `<div class="chat-bubble-wrap ${mineClass}">
                    <div class="chat-meta" style="${metaAlign}">
                        <span style="font-weight: 700; color: #ffffff;">${escapeHtml(m.senderName)}</span>
                        <span>${escapeHtml(m.timeText)}</span>
                    </div>
                    <div class="chat-bubble">${escapeHtml(m.messageText)}</div>
                </div>`;
            });
            box.innerHTML = html;
            scrollToBottom();
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    })();
</script>
