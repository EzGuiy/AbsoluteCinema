@model Kawin_67091861_002.ViewModels.ManagerChatViewModel
@{
    Layout = "_LayoutStaff";
    ViewData["Title"] = "แชทและการสื่อสารฝ่ายบริการ";
}

<style>
    .staff-chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .staff-chat-title {
        font-size: 24px;
        font-weight: 700;
        color: #ffffff;
    }

    .staff-chat-sub {
        font-size: 13px;
        color: var(--text-secondary);
        margin-top: 4px;
    }

    .chat-grid-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 20px;
        height: calc(100vh - 200px);
        min-height: 580px;
    }

    /* Channels List */
    .channels-panel {
        background: var(--bg-card);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .channels-head {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-card);
        font-size: 12px;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 0.5px;
    }

    .channels-body {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .room-link {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 10px;
        text-decoration: none;
        color: var(--text-secondary);
        border: 1px solid transparent;
        transition: all 0.2s;
    }

    .room-link:hover {
        background: var(--bg-card-subtle);
        color: #ffffff;
    }

    .room-link.active {
        background: rgba(14, 165, 233, 0.12);
        border-color: rgba(14, 165, 233, 0.4);
        color: #ffffff;
    }

    .room-avatar {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        flex-shrink: 0;
        background: rgba(14, 165, 233, 0.15);
        color: #38bdf8;
        border: 1px solid rgba(14, 165, 233, 0.3);
    }

    .room-info {
        flex: 1;
        min-width: 0;
    }

    .room-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2px;
    }

    .room-name {
        font-size: 13.5px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .room-msg-preview {
        font-size: 11.5px;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Conversation */
    .conversation-panel {
        background: var(--bg-card);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .conv-top-bar {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border-card);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .conv-head-title {
        font-size: 16px;
        font-weight: 700;
        color: #ffffff;
    }

    .conv-head-sub {
        font-size: 11.5px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .conv-stream {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .chat-bubble-wrap {
        display: flex;
        flex-direction: column;
        gap: 4px;
        max-width: 80%;
    }

    .chat-bubble-wrap.theirs {
        align-self: flex-start;
    }

    .chat-bubble-wrap.mine {
        align-self: flex-end;
    }

    .chat-meta {
        font-size: 11px;
        color: var(--text-muted);
        display: flex;
        gap: 8px;
    }

    .chat-bubble {
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 13.5px;
        line-height: 1.5;
    }

    .chat-bubble-wrap.theirs .chat-bubble {
        background: #172130;
        border: 1px solid var(--border-card);
        color: #e2e8f0;
    }

    .chat-bubble-wrap.mine .chat-bubble {
        background: rgba(14, 165, 233, 0.15);
        border: 1px solid rgba(14, 165, 233, 0.4);
        color: #e0f2fe;
    }

    .chat-input-bar {
        padding: 16px 24px;
        border-top: 1px solid var(--border-card);
        background: #0e131b;
    }

    .chat-send-form {
        display: flex;
        gap: 12px;
    }

    .chat-send-input {
        flex: 1;
        background: #121924;
        border: 1px solid var(--border-card);
        color: #fff;
        padding: 10px 16px;
        border-radius: 8px;
        font-size: 13.5px;
    }

    .chat-send-input:focus {
        outline: none;
        border-color: #0ea5e9;
    }

    .btn-send-cyan {
        background: #0ea5e9;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
    }

    .btn-send-cyan:hover {
        background: #0284c7;
    }
</style>

<div class="staff-chat-header">
    <div>
        <h1 class="staff-chat-title">แชทและการสื่อสารฝ่ายบริการ</h1>
        <div class="staff-chat-sub">ประสานงานด่วนระหว่างพนักงานบริการ ช่างเทคนิค ผู้จัดการ และฝ่ายบัญชี</div>
    </div>
</div>

<div class="chat-grid-layout">
    <!-- Channels List -->
    <div class="channels-panel">
        <div class="channels-head">กลุ่มการสื่อสาร (CHANNELS)</div>
        <div class="channels-body">
            @foreach (var room in Model.Rooms)
            {
                <a asp-controller="Staff" asp-action="Chat" asp-route-channel="@room.Id" 
                   class="room-link @(room.IsActive ? "active" : "")">
                    <div class="room-avatar">
                        <i class="bi bi-hash"></i>
                    </div>
                    <div class="room-info">
                        <div class="room-title-row">
                            <span class="room-name">@room.Name</span>
                            @if (room.UnreadCount > 0)
                            {
                                <span class="badge" style="background:#e50914; font-size:10px; border-radius:10px; padding:2px 7px;">@room.UnreadCount</span>
                            }
                        </div>
                        <div class="room-msg-preview">@room.LastMessageText</div>
                    </div>
                </a>
            }
        </div>
    </div>

    <!-- Active Conversation -->
    <div class="conversation-panel">
        <div class="conv-top-bar">
            <div>
                <div class="conv-head-title"><i class="bi bi-hash text-info"></i> @Model.ActiveRoom.Name</div>
                <div class="conv-head-sub">@Model.ActiveRoom.MembersInfo</div>
            </div>
        </div>

        <div class="conv-stream" id="staffMsgBox">
            @if (!Model.Messages.Any())
            {
                <div style="text-align: center; color: var(--text-muted); margin-top: 40px;">
                    <i class="bi bi-chat-dots" style="font-size: 32px; display: block; margin-bottom: 8px;"></i>
                    ยังไม่มีข้อความในห้องนี้ เริ่มต้นส่งข้อความแรกได้เลย
                </div>
            }
            else
            {
                @foreach (var msg in Model.Messages)
                {
                    <div class="chat-bubble-wrap @(msg.IsMine ? "mine" : "theirs")">
                        <div class="chat-meta" style="@(msg.IsMine ? "justify-content: flex-end;" : "")">
                            <span style="font-weight: 700; color: #ffffff;">@msg.SenderName</span>
                            <span>@msg.TimeText</span>
                        </div>
                        <div class="chat-bubble">
                            @msg.MessageText
                        </div>
                    </div>
                }
            }
        </div>

        <div class="chat-input-bar">
            <form asp-controller="Staff" asp-action="SendStaffChatMessage" method="post" class="chat-send-form">
                <input type="hidden" name="channel" value="@Model.ActiveRoomId" />
                <input type="text" name="message" class="chat-send-input" placeholder="พิมพ์ข้อความถึง@Model.ActiveRoom.Name..." autocomplete="off" required />
                <button type="submit" class="btn-send-cyan">
                    <span>ส่ง</span>
                    <i class="bi bi-send-fill"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', function () {
        var box = document.getElementById('staffMsgBox');
        if (box) {
            box.scrollTop = box.scrollHeight;
        }
    });
</script>
