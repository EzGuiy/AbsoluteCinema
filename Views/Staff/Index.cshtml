@model Kawin_67091861_002.ViewModels.StaffDashboardViewModel
@{
    ViewData["Title"] = "พนักงานบริการ - ภาพรวมและสถิติ";
    Layout = "_LayoutStaff";
}

<!-- Top Header Row -->
<div class="staff-top-header">
    <div>
        <div class="staff-pre-title">FLOOR OPERATIONS & SERVICE</div>
        <h1 class="staff-main-title">ภาพรวมงานบริการพนักงาน</h1>
        <div class="staff-sub-title">
            สรุปข้อมูลผู้เข้าชม การจองประจำวัน และสถานะความพร้อมโรงภาพยนตร์ • ประจำวันที่ @DateTime.Now.ToString("dd MMMM yyyy")
        </div>
    </div>

    <div class="staff-top-actions">
        <a asp-action="Halls" class="btn-check-halls">
            <i class="bi bi-display-fill me-1"></i> เข้าสู่ระบบตรวจโรงภาพยนตร์
        </a>
    </div>
</div>

<!-- 4 Key Stat Cards Row -->
<div class="staff-kpi-grid">
    <!-- Card 1: จำนวนลูกค้าที่จะเข้ามาวันนี้ -->
    <div class="staff-stat-card">
        <div class="stat-top-flex">
            <span class="stat-name">จำนวนลูกค้าคาดการณ์วันนี้</span>
            <div class="stat-icon-wrap cyan">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
        <div class="stat-number">@Model.ExpectedCustomersToday.ToString("N0") <span class="unit-text">คน</span></div>
        <div class="stat-change-text cyan">@Model.ExpectedCustomersChange</div>
    </div>

    <!-- Card 2: จำนวนการจองในวันนั้นๆ -->
    <div class="staff-stat-card">
        <div class="stat-top-flex">
            <span class="stat-name">จำนวนการจองในวันนี้</span>
            <div class="stat-icon-wrap green">
                <i class="bi bi-ticket-perforated-fill"></i>
            </div>
        </div>
        <div class="stat-number">@Model.TodayBookingsCount.ToString("N0") <span class="unit-text">รายการ</span></div>
        <div class="stat-change-text muted">@Model.TodayBookingsSubtext</div>
    </div>

    <!-- Card 3: โรงภาพยนตร์ที่ให้บริการ -->
    <div class="staff-stat-card">
        <div class="stat-top-flex">
            <span class="stat-name">โรงภาพยนตร์ที่ให้บริการ</span>
            <div class="stat-icon-wrap amber">
                <i class="bi bi-display"></i>
            </div>
        </div>
        <div class="stat-number">@Model.ActiveHallsCount <span class="unit-text">โรง</span></div>
        <div class="stat-change-text muted">@Model.ActiveHallsSubtext</div>
    </div>

    <!-- Card 4: ความพร้อมตรวจโรงภาพยนตร์ -->
    <div class="staff-stat-card">
        <div class="stat-top-flex">
            <span class="stat-name">อัตราความพร้อมของโรงภาพยนตร์</span>
            <div class="stat-icon-wrap green">
                <i class="bi bi-check2-circle"></i>
            </div>
        </div>
        <div class="stat-number">@Model.HallsReadinessPercent.ToString("0.0")%</div>
        <div class="stat-change-text green">@Model.HallsReadinessSubtext</div>
    </div>
</div>

<!-- Main 2-Column Section -->
<div class="staff-main-grid">
    <!-- Left Column: Halls Quick Overview -->
    <div class="staff-left-col">
        <div class="staff-panel-box">
            <div class="panel-header-split">
                <div>
                    <h2 class="panel-head-title">สถานะโรงภาพยนตร์และรอบฉายขณะนี้</h2>
                    <span class="panel-head-sub">คลิกที่โรงเพื่อเปิดดูผังที่นั่งหรือเรียกช่างเทคนิค</span>
                </div>
                <a asp-action="Halls" class="panel-link-cyan">ดูระบบตรวจโรงทั้งหมด (8 โรง) <i class="bi bi-arrow-right"></i></a>
            </div>

            <div class="halls-summary-grid mt-3">
                @foreach (var hall in Model.Halls.Take(4))
                {
                    <div class="hall-mini-card">
                        <div class="hm-header">
                            <span class="hm-name">@hall.HallName</span>
                            @if (hall.ShowingStatus == "พร้อมเข้าชม")
                            {
                                <span class="badge-status-pill green">พร้อมเข้าชม</span>
                            }
                            else if (hall.ShowingStatus.Contains("ใกล้จบ"))
                            {
                                <span class="badge-status-pill amber">ใกล้จบ (รอตรวจ)</span>
                            }
                            else
                            {
                                <span class="badge-status-pill blue">กำลังฉาย</span>
                            }
                        </div>
                        <div class="hm-movie">@hall.CurrentMovieTitle</div>
                        <div class="hm-time-range">
                            <i class="bi bi-clock me-1"></i> @hall.StartTimeText - @hall.EndTimeText น.
                        </div>

                        <!-- Progress Bar -->
                        <div class="hm-progress-wrap mt-2">
                            <div class="hm-progress-bar" style="width: @hall.ProgressPercent%;"></div>
                        </div>

                        <div class="hm-footer mt-3">
                            <span class="hm-seats text-muted">
                                จองแล้ว @hall.BookedSeatsCount / @hall.TotalSeats ที่นั่ง
                            </span>
                            <a asp-action="HallDetail" asp-route-id="@hall.HallId" class="btn-view-seats">
                                ผังที่นั่ง <i class="bi bi-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Shift Tasks -->
    <div class="staff-right-col">
        <div class="staff-panel-box">
            <div class="panel-header-split mb-3">
                <h3 class="panel-section-title">ภารกิจและการเตรียมพร้อมกะ</h3>
                <span class="badge rounded-pill bg-info text-dark" style="font-size:11px;">วันนี้</span>
            </div>

            <div class="tasks-timeline-list">
                @foreach (var task in Model.ShiftTasks)
                {
                    <div class="task-timeline-item">
                        <div class="task-time">@task.TimeText</div>
                        <div class="task-info">
                            <div class="task-hall">@task.HallName</div>
                            <div class="task-title">@task.TaskTitle</div>
                        </div>
                        <span class="task-badge @task.BadgeColor">@task.Status</span>
                    </div>
                }
            </div>

            <!-- Call Tech Ops Shortcut Box -->
            <div class="call-tech-shortcut-box mt-4">
                <div class="cts-icon">
                    <i class="bi bi-tools text-warning fs-4"></i>
                </div>
                <div class="cts-texts">
                    <div class="cts-title">พบอุปกรณ์ขัดข้องหรือต้องการทดสอบโรง?</div>
                    <div class="cts-sub">กดปุ่มเรียกช่างเทคนิคจากหน้าระบบตรวจโรงได้ทันที</div>
                </div>
                <a asp-action="Halls" class="btn btn-sm btn-outline-warning">
                    ไปที่ตรวจโรง
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Real-time Ticket Records & Bookings Table -->
<div class="staff-panel-box mt-4">
    <div class="panel-header-split mb-3">
        <div>
            <h3 class="panel-section-title" style="color: #ffffff; font-size: 17px; font-weight: 700;">
                <i class="bi bi-ticket-perforated-fill text-warning me-2"></i>
                รายการรหัสตั๋วและบันทึกการจองภาพยนตร์ (Real-time Ticket Records)
            </h3>
            <span class="panel-head-sub" style="font-size: 12px; color: #8c8c9e;">
                บันทึกรหัสอ้างอิงตั๋ว (Ticket ID), รอบฉาย, ชื่อลูกค้า, เบอร์โทรศัพท์ และที่นั่งสำหรับพนักงานตรวจสอบ
            </span>
        </div>
        <span class="badge bg-primary" style="font-size: 11.5px; padding: 6px 12px; border-radius: 6px;">อัปเดตเรียลไทม์</span>
    </div>

    @if (Model.RecentBookings != null && Model.RecentBookings.Any())
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="font-size: 13px; background: transparent;">
                <thead>
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.1); color: #8c8c9e;">
                        <th>รหัสตั๋ว (TICKET ID)</th>
                        <th>ภาพยนตร์ / โรง</th>
                        <th>รอบฉาย</th>
                        <th>ที่นั่ง</th>
                        <th>ชื่อลูกค้า</th>
                        <th>เบอร์โทรศัพท์</th>
                        <th>ยอดชำระ</th>
                        <th>สถานะ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentBookings)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td>
                                <span class="font-monospace fw-bold text-warning" style="letter-spacing: 0.5px;">@item.ReferenceCode</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-white">@item.MovieTitle</div>
                                <div class="text-muted small">@item.CinemaName</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.ShowtimeText</span>
                            </td>
                            <td>
                                <span class="fw-bold text-info">@item.SeatNumbers</span>
                                <span class="text-muted small">(@item.SeatCount ที่นั่ง)</span>
                            </td>
                            <td class="text-white">@item.CustomerName</td>
                            <td>
                                <span class="font-monospace" style="color: #38bdf8;">@item.CustomerPhone</span>
                            </td>
                            <td class="fw-bold text-success">฿@item.TotalAmount.ToString("N0")</td>
                            <td>
                                @if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">ยกเลิกแล้ว</span>
                                }
                                else if (item.Status == "รอดำเนินการคืนเงิน")
                                {
                                    <span class="badge bg-warning text-dark">รอดำเนินการคืนเงิน</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">ยืนยันการจองแล้ว</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">
            <i class="bi bi-inbox fs-2 mb-2 d-block"></i>
            ยังไม่มีรายการจองภาพยนตร์ในรอบนี้
        </div>
    }
</div>

<style>
    /* Header */
    .staff-top-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .staff-pre-title {
        font-size: 11px;
        font-weight: 700;
        color: var(--accent-cyan);
        letter-spacing: 1.5px;
        margin-bottom: 2px;
    }

    .staff-main-title {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin: 0;
    }

    .staff-sub-title {
        font-size: 12px;
        color: var(--text-secondary);
        margin-top: 4px;
    }

    .btn-check-halls {
        background: #0284c7;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        padding: 9px 18px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
        transition: all 0.2s ease;
    }

    .btn-check-halls:hover {
        background: #0ea5e9;
        color: #ffffff;
        transform: translateY(-1px);
    }

    /* 4 KPI Grid */
    .staff-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .staff-stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        padding: 20px 22px;
    }

    .stat-top-flex {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .stat-name {
        font-size: 12.5px;
        color: var(--text-secondary);
        font-weight: 500;
    }

    .stat-icon-wrap {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
    }

    .stat-icon-wrap.cyan { background: rgba(14, 165, 233, 0.15); color: #38bdf8; }
    .stat-icon-wrap.green { background: rgba(16, 185, 129, 0.15); color: #34d399; }
    .stat-icon-wrap.amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }

    .stat-number {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 4px;
        letter-spacing: -0.5px;
    }

    .stat-number .unit-text {
        font-size: 14px;
        font-weight: 500;
        color: var(--text-muted);
    }

    .stat-change-text {
        font-size: 11.5px;
    }

    .stat-change-text.cyan { color: #38bdf8; }
    .stat-change-text.green { color: #10b981; }
    .stat-change-text.muted { color: var(--text-muted); }

    /* Main Grid */
    .staff-main-grid {
        display: grid;
        grid-template-columns: 1.55fr 1fr;
        gap: 22px;
    }

    .staff-panel-box {
        background: var(--bg-card);
        border: 1px solid var(--border-card);
        border-radius: 12px;
        padding: 24px;
    }

    .panel-header-split {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .panel-head-title {
        font-size: 17px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .panel-head-sub {
        font-size: 11.5px;
        color: var(--text-muted);
    }

    .panel-section-title {
        font-size: 15px;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .panel-link-cyan {
        font-size: 12.5px;
        color: var(--accent-cyan);
        text-decoration: none;
    }

    /* Halls Mini Grid */
    .halls-summary-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .hall-mini-card {
        background: var(--bg-card-subtle);
        border: 1px solid var(--border-card);
        border-radius: 10px;
        padding: 16px;
    }

    .hm-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .hm-name {
        font-size: 13.5px;
        font-weight: 700;
        color: #ffffff;
    }

    .badge-status-pill {
        font-size: 10.5px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 12px;
    }

    .badge-status-pill.green { background: rgba(16, 185, 129, 0.15); color: #34d399; }
    .badge-status-pill.amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
    .badge-status-pill.blue { background: rgba(14, 165, 233, 0.15); color: #38bdf8; }

    .hm-movie {
        font-size: 13px;
        font-weight: 600;
        color: #e2e8f0;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .hm-time-range {
        font-size: 11.5px;
        color: var(--text-secondary);
    }

    .hm-progress-wrap {
        width: 100%;
        height: 5px;
        background: #0f1620;
        border-radius: 4px;
        overflow: hidden;
    }

    .hm-progress-bar {
        height: 100%;
        background: #0284c7;
        border-radius: 4px;
    }

    .hm-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 11.5px;
    }

    .btn-view-seats {
        color: var(--accent-cyan);
        text-decoration: none;
        font-weight: 600;
    }

    /* Task Timeline */
    .tasks-timeline-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .task-timeline-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        background: var(--bg-card-subtle);
        border-radius: 8px;
        border: 1px solid var(--border-card);
    }

    .task-time {
        font-size: 11px;
        font-weight: 700;
        color: #38bdf8;
        white-space: nowrap;
    }

    .task-info {
        flex: 1;
        line-height: 1.25;
    }

    .task-hall {
        font-size: 10.5px;
        color: var(--text-muted);
    }

    .task-title {
        font-size: 12px;
        color: #ffffff;
        font-weight: 500;
    }

    .task-badge {
        font-size: 10px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 8px;
    }

    .task-badge.green { background: rgba(16, 185, 129, 0.15); color: #34d399; }
    .task-badge.orange { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }

    /* Call Tech Shortcut Box */
    .call-tech-shortcut-box {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        background: #171c26;
        border: 1px dashed rgba(245, 158, 11, 0.4);
        border-radius: 10px;
    }

    .cts-texts {
        flex: 1;
        line-height: 1.25;
    }

    .cts-title {
        font-size: 12px;
        font-weight: 700;
        color: #ffffff;
    }

    .cts-sub {
        font-size: 10.5px;
        color: var(--text-muted);
    }

    @@media (max-width: 992px) {
        .staff-kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .staff-main-grid { grid-template-columns: 1fr; }
        .halls-summary-grid { grid-template-columns: 1fr; }
    }
</style>

