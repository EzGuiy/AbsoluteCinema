@model Kawin_67091861_002.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "ชำระเงิน - " + Model.MovieTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="payment-page-container">
    <!-- Stepper Flow -->
    <div class="checkout-stepper">
        <div class="step-item completed">
            <div class="step-circle"><i class="bi bi-check"></i></div>
            <span class="step-label">1. เลือกรอบฉาย</span>
        </div>
        <div class="step-line active"></div>
        <div class="step-item completed">
            <div class="step-circle"><i class="bi bi-check"></i></div>
            <span class="step-label">2. เลือกที่นั่ง</span>
        </div>
        <div class="step-line active"></div>
        <div class="step-item current">
            <div class="step-circle">3</div>
            <span class="step-label">3. ชำระเงิน</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item">
            <div class="step-circle">4</div>
            <span class="step-label">4. รับตั๋วชมภาพยนตร์</span>
        </div>
    </div>

    <!-- 2 Columns Payment Layout -->
    <div class="payment-grid">
        <!-- LEFT COLUMN: Booking Order Details -->
        <div class="payment-left-col">
            <div class="order-card">
                <h3 class="card-heading">
                    <span class="gold-accent-dot"></span>
                    รายละเอียดการจอง
                </h3>

                <!-- Movie Info Box -->
                <div class="movie-receipt-header">
                    <div class="receipt-poster">
                        @if (!string.IsNullOrEmpty(Model.PosterUrl))
                        {
                            <img src="@Model.PosterUrl" alt="@Model.MovieTitle" class="receipt-poster-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        }
                        <div class="receipt-graphic @(string.IsNullOrEmpty(Model.PosterUrl) ? "" : "hidden-fallback")">
                            <span class="receipt-crown">&#9818;</span>
                        </div>
                    </div>
                    <div class="receipt-title-box">
                        <h4 class="receipt-movie-title">@Model.MovieTitle</h4>
                        <span class="receipt-hall-pill">@Model.HallTier</span>
                        <div class="receipt-cinema-name"><i class="bi bi-geo-alt-fill"></i> @Model.CinemaName</div>
                    </div>
                </div>

                <div class="receipt-divider"></div>

                <!-- Showtime & Seat Details -->
                <div class="receipt-specs">
                    <div class="spec-row">
                        <span class="spec-label">วันที่และเวลา</span>
                        <span class="spec-value">@Model.DateDisplayTh | @Model.TimeDisplayTh</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">ที่นั่งที่เลือก</span>
                        <div class="seats-pill-list">
                            @foreach (var s in Model.SelectedSeats)
                            {
                                <span class="seat-badge">@s</span>
                            }
                        </div>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">จำนวนตั๋ว</span>
                        <span class="spec-value">@Model.SeatCount ที่นั่ง</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">ราคาต่อที่นั่ง</span>
                        <span class="spec-value">฿@Model.PricePerSeat.ToString("N0")</span>
                    </div>
                </div>

                <div class="receipt-divider"></div>

                <!-- Price Calculations -->
                <div class="receipt-calc">
                    <div class="spec-row small">
                        <span class="spec-label">ยอดรวมค่าตั๋ว</span>
                        <span class="spec-value">฿@Model.Subtotal.ToString("N0")</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="spec-row small discount-spec">
                            <span class="spec-label">ส่วนลดโปรโมชั่น (@Model.AppliedPromoCode)</span>
                            <span class="spec-value discount-green">-฿@Model.DiscountAmount.ToString("N0")</span>
                        </div>
                    }
                    <div class="spec-row small">
                        <span class="spec-label">ภาษีมูลค่าเพิ่ม (VAT 7%)</span>
                        <span class="spec-value">รวมในยอดชำระแล้ว</span>
                    </div>
                </div>

                <div class="receipt-divider thick"></div>

                <!-- Grand Total -->
                <div class="grand-total-row">
                    <div class="gt-label">
                        <span class="gt-title">ยอดชำระสุทธิ</span>
                        <span class="gt-sub">Total Amount (THB)</span>
                    </div>
                    <div class="gt-value">฿@Model.TotalAmount.ToString("N0")</div>
                </div>

                <div class="ref-code-box">
                    <span>รหัสอ้างอิง:</span>
                    <strong>@Model.BookingReferenceCode</strong>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Payment Method Selection -->
        <div class="payment-right-col">
            <div class="payment-box-card">
                <!-- Top Timer & Heading -->
                <div class="payment-box-header">
                    <h3 class="card-heading">
                        <span class="gold-accent-dot"></span>
                        เลือกช่องทางการชำระเงิน
                    </h3>
                    <div class="countdown-badge">
                        <span class="timer-icon">&#9201;</span>
                        <span>กรุณาชำระเงินภายใน</span>
                        <strong id="timerDisplay" class="timer-digits">14:59</strong>
                        <span>นาที</span>
                    </div>
                </div>

                <!-- Payment Methods Tabs -->
                <div class="payment-method-tabs">
                    <button type="button" class="method-tab active" data-method="PromptPay" onclick="switchTab(this, 'qrTab')">
                        <i class="bi bi-qr-code-scan"></i>
                        <span>สแกนจ่ายด้วย QR CODE</span>
                    </button>
                    <button type="button" class="method-tab" data-method="CreditCard" onclick="switchTab(this, 'creditTab')">
                        <i class="bi bi-credit-card-2-front"></i>
                        <span>บัตรเครดิต/เดบิต</span>
                    </button>
                    <button type="button" class="method-tab" data-method="BankTransfer" onclick="switchTab(this, 'bankTab')">
                        <i class="bi bi-bank"></i>
                        <span>โอนผ่านธนาคาร</span>
                    </button>
                </div>

                <!-- TAB 1: QR Code PromptPay -->
                <div id="qrTab" class="tab-pane active">
                    <div class="qr-payment-panel">
                        <div class="thai-qr-header">
                            <div class="thai-qr-logo">Thai QR Payment</div>
                            <div class="promptpay-badge">พร้อมเพย์ PromptPay</div>
                        </div>

                        <div class="qr-canvas-wrapper">
                            <!-- Real Scannable PromptPay QR Code to 0933632239 with exact amount -->
                            <div style="background:#ffffff; padding:14px; border-radius:12px; display:inline-block; margin: 10px auto; box-shadow: 0 4px 20px rgba(0,0,0,0.5);">
                                <img id="realPromptPayQr"
                                     src="@Model.PromptPayQrUrl"
                                     alt="PromptPay QR Code เบอร์ 0933632239 ยอดเงิน ฿@Model.TotalAmount"
                                     style="width:230px; height:230px; object-fit:contain; display:block;"
                                     onerror="this.onerror=null; this.src='https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=@System.Net.WebUtility.UrlEncode(Model.PromptPayPayload)';" />
                            </div>

                            <div class="qr-scan-guide">
                                <span class="guide-lead"><i class="bi bi-phone-fill text-warning me-1"></i> สแกนจ่ายด้วยแอปธนาคารใดก็ได้ทันที</span>
                                <div style="background: rgba(223, 183, 108, 0.1); border: 1px solid rgba(223, 183, 108, 0.3); border-radius: 8px; padding: 10px 14px; margin: 10px 0; text-align: left;">
                                    <div style="font-size: 13px; color: #dfb76c; font-weight: 700; display: flex; justify-content: space-between; align-items: center;">
                                        <span>เบอร์พร้อมเพย์: @Model.PromptPayPhoneFormatted</span>
                                        <button type="button" onclick="navigator.clipboard.writeText('@Model.PromptPayPhone'); alert('คัดลอกเบอร์พร้อมเพย์ 0933632239 แล้ว');" 
                                                style="background: #dfb76c; color: #000; border: none; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer;">
                                            คัดลอกเบอร์
                                        </button>
                                    </div>
                                    <div style="font-size: 12px; color: #a4a4b4; margin-top: 3px;">ชื่อบัญชี: บจก. แอบโซลูท ซินีม่า (ประเทศไทย)</div>
                                    <div style="font-size: 13px; color: #4ade80; font-weight: 700; margin-top: 4px;">
                                        ยอดชำระจริง: ฿@Model.TotalAmount.ToString("N0") บาท 
                                    </div>
                                </div>
                                <span style="font-size: 11.5px; color: #8c8c9e;">*เปิดแอปพลิเคชันธนาคารของคุณ และเลือกเมนู 'สแกน QR' เพื่อสแกนภาพด้านบน</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: Credit Card Form -->
                <div id="creditTab" class="tab-pane">
                    <div class="credit-card-form">
                        <div class="form-group">
                            <label>หมายเลขบัตรเครดิต / เดบิต (ใส่เลขอะไรก็ได้)</label>
                            <input type="text" id="creditCardNum" class="card-input" placeholder="ใส่เลขอะไรก็ได้ เช่น 4111 2222 3333 4444" value="4111222233334444" />
                            <small style="color: #4ade80; font-size: 11px; margin-top: 4px; display: block;">* สามารถกรอกเลขบัตรอะไรก็ได้ ระบบเปิดรับชำระได้จริงทันที</small>
                        </div>
                        <div class="form-group">
                            <label>ชื่อบนบัตร</label>
                            <input type="text" id="creditCardHolder" class="card-input" placeholder="SURNAME FIRSTNAME" value="ABSOLUTE CARDHOLDER" />
                        </div>
                        <div class="form-row-2">
                            <div class="form-group">
                                <label>วันหมดอายุ (MM/YY)</label>
                                <input type="text" id="creditCardExp" class="card-input" placeholder="12/28" value="12/28" />
                            </div>
                            <div class="form-group">
                                <label>รหัส CVV</label>
                                <input type="text" id="creditCardCvv" class="card-input" placeholder="123" value="123" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TAB 3: Bank Transfer -->
                <div id="bankTab" class="tab-pane">
                    <div class="bank-transfer-list">
                        <div class="bank-item">
                            <div class="bank-badge kbank">KBANK</div>
                            <div class="bank-details">
                                <span class="bank-name">ธนาคารกสิกรไทย</span>
                                <span class="acc-num">095-2-67891-0</span>
                                <span class="acc-name">บจก. แอบโซลูท ซินีม่า</span>
                            </div>
                        </div>
                        <div class="bank-item">
                            <div class="bank-badge scb">SCB</div>
                            <div class="bank-details">
                                <span class="bank-name">ธนาคารไทยพาณิชย์</span>
                                <span class="acc-num">408-9-12345-6</span>
                                <span class="acc-name">บจก. แอบโซลูท ซินีม่า</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Customer Details for Receipt / DB -->
                <div class="customer-info-box">
                    <div class="ci-title"><i class="bi bi-person-fill"></i> ข้อมูลผู้จองภาพยนตร์</div>
                    <div class="ci-row">
                        <input type="text" id="custName" class="ci-input" placeholder="ชื่อ-นามสกุล ผู้จอง" value="คุณลูกค้า Absolute Cinema" />
                        <input type="tel" id="custPhone" class="ci-input" placeholder="เบอร์โทรศัพท์มือถือ" value="081-234-5678" />
                    </div>
                </div>

                <!-- CTA Confirmation Button -->
                <button type="button" id="btnConfirmPay" class="btn-confirm-payment" onclick="executePayment()">
                    <span id="btnPayText">ยืนยันการชำระเงิน (CHECK) - ฿@Model.TotalAmount.ToString("N0")</span>
                    <span id="btnPaySpinner" class="spinner-border spinner-border-sm" style="display: none;"></span>
                </button>

                <div class="payment-guarantee">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>ระบบเข้ารหัสความปลอดภัย 256-bit SSL | บันทึกประวัติและออกตั๋วลง Database อัตโนมัติ</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: Digital Cinema Ticket / Success Confirmation Pop-up -->
<!-- ======================================================== -->
<div id="ticketModal" class="ticket-modal-overlay">
    <div class="ticket-modal-content">
        <div class="ticket-gold-header">
            <div class="th-brand">
                <span class="th-crown">&#9818;</span>
                <span class="th-name">ABSOLUTE CINEMA</span>
            </div>
            <div class="th-status">
                <i class="bi bi-check-circle-fill"></i> การจองสำเร็จ (CONFIRMED)
            </div>
        </div>

        <!-- Cinema Ticket Card Body -->
        <div class="cinema-ticket-card">
            <div class="ticket-top-section">
                <div class="t-movie-title" id="tMovieTitle">@Model.MovieTitle</div>
                <div class="t-badges">
                    <span class="t-badge gold">GOLD CLASS</span>
                    <span class="t-badge">DOLBY ATMOS</span>
                    <span class="t-badge">4K LASER</span>
