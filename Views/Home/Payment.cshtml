        <!-- Action Buttons inside Modal -->
        <div class="ticket-actions">
            <a href="@Url.Action("Tickets", "Account")" class="btn-ticket-print" style="background:#dfb76c; color:#000; text-decoration:none; display:flex; align-items:center; justify-content:center; gap:6px; font-weight:700;">
                <i class="bi bi-ticket-perforated-fill"></i> ไปที่หน้าตั๋วหนังของฉัน
