<style>
    .payment-page-container {
        max-width: 1240px;
        margin: 0 auto;
        padding: 30px 20px 80px;
        color: #e5e5ec;
        font-family: 'Prompt', sans-serif;
    }

    /* Stepper Flow */
    .checkout-stepper {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 760px;
        margin: 0 auto 35px;
    }

    .step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .step-circle {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #1c1c2b;
        border: 2px solid #36364c;
        color: #8b8b9e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
        transition: all 0.3s;
    }

    .step-item.completed .step-circle {
        background: #dfb76c;
        border-color: #dfb76c;
        color: #0b0b12;
    }

    .step-item.current .step-circle {
        background: #dfb76c;
        border-color: #dfb76c;
        color: #0b0b12;
        box-shadow: 0 0 15px rgba(223, 183, 108, 0.6);
    }

    .step-label {
        font-size: 0.8rem;
        color: #79798e;
        white-space: nowrap;
    }

    .step-item.current .step-label, .step-item.completed .step-label {
        color: #dfb76c;
        font-weight: 600;
    }

    .step-line {
        flex: 1;
        height: 2px;
        background: #2a2a3e;
        margin: 0 12px 20px;
    }

    .step-line.active {
        background: #dfb76c;
    }

    /* 2 Column Payment Grid */
    .payment-grid {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 30px;
        align-items: start;
    }

    /* Left Order Details Card */
    .order-card, .payment-box-card {
        background: #12121e;
        border: 1px solid rgba(223, 183, 108, 0.25);
        border-radius: 16px;
        padding: 28px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 10px;
