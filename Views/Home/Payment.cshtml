<script>
    const showtimeId = @Model.ShowtimeId;
    const movieId = @Model.MovieId;
    const selectedSeatsStr = "@Model.SelectedSeatsString";
    const totalAmount = @Model.TotalAmount;
    const promoCode = "@Model.AppliedPromoCode";
    let activePaymentMethod = "PromptPay";

    // Switch payment tabs
    function switchTab(btn, tabId) {
        document.querySelectorAll('.method-tab').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        document.getElementById(tabId).classList.add('active');
        activePaymentMethod = btn.getAttribute('data-method');
    }

    // 15-Minute Countdown Timer
    let totalSeconds = 15 * 60;
    const timerElem = document.getElementById('timerDisplay');
    const timerInterval = setInterval(function () {
        totalSeconds--;
        if (totalSeconds <= 0) {
            clearInterval(timerInterval);
            timerElem.innerText = "00:00";
            alert("⚠️ เวลาในการชำระเงินหมดอายุแล้ว กรุณาเริ่มทำรายการใหม่อีกครั้ง");
            window.location.href = `/Home/SelectSeat?showtimeId=${showtimeId}`;
            return;
        }

        const mins = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
        const secs = (totalSeconds % 60).toString().padStart(2, '0');
        timerElem.innerText = `${mins}:${secs}`;
    }, 1000);

    // Execute Payment & Save to Database
    function executePayment() {
        const btnPay = document.getElementById('btnConfirmPay');
        const textSpan = document.getElementById('btnPayText');
        const spinner = document.getElementById('btnPaySpinner');
        const custName = document.getElementById('custName').value.trim();
        const custPhone = document.getElementById('custPhone').value.trim();

        btnPay.disabled = true;
        textSpan.innerText = "กำลังตรวจสอบยอดชำระเงินและบันทึกลง Database...";
        spinner.style.display = "inline-block";

        const payload = {
            showtimeId: showtimeId,
            movieId: movieId,
            showtimeDate: '@Model.SelectedDateStr',
            selectedSeats: selectedSeatsStr,
            totalAmount: totalAmount,
            promoCode: promoCode,
            paymentMethod: activePaymentMethod,
            customerName: custName,
            customerPhone: custPhone
        };

        fetch('/Home/ConfirmBooking', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // Populate ticket modal
                document.getElementById('tMovieTitle').innerText = data.movieTitle || "@Model.MovieTitle";
                document.getElementById('tCinemaName').innerText = data.cinemaName || "@Model.CinemaName";
                document.getElementById('tShowtime').innerText = data.showtimeStr || "@Model.DateDisplayTh | @Model.TimeDisplayTh";
                document.getElementById('tSeats').innerText = data.seats || selectedSeatsStr;
                document.getElementById('tAmount').innerText = "฿" + Number(data.totalAmount).toLocaleString();
                document.getElementById('tRefCode').innerText = data.referenceCode;
                document.getElementById('tInvoiceNo').innerText = data.taxInvoiceNo;
                document.getElementById('tBarcodeText').innerText = data.referenceCode;

                // Stop countdown
                clearInterval(timerInterval);

                // Show modal
                const modal = document.getElementById('ticketModal');
                modal.style.display = 'flex';
            } else {
                alert(data.message || "เกิดข้อผิดพลาดในการชำระเงิน");
                btnPay.disabled = false;
                textSpan.innerText = "ยืนยันการชำระเงิน (CHECK) - ฿" + totalAmount.toLocaleString();
                spinner.style.display = "none";
            }
        })
        .catch(err => {
            alert("เกิดข้อผิดพลาดในการเชื่อมต่อเซิร์ฟเวอร์ กรุณาลองใหม่อีกครั้ง");
            btnPay.disabled = false;
            textSpan.innerText = "ยืนยันการชำระเงิน (CHECK) - ฿" + totalAmount.toLocaleString();
            spinner.style.display = "none";
        });
    }
</script>

