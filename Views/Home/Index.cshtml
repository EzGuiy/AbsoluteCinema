@model Kawin_67091861_002.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "หน้าแรก - ABSOLUTE CINEMA";
}

<style>
    :root {
        --cinema-gold: #c69c43;
        --cinema-gold-light: #dfb76c;
        --cinema-gold-dark: #8c6a23;
        --cinema-dark: #0a0a0f;
        --cinema-card: #121218;
        --cinema-card-border: rgba(198, 156, 67, 0.15);
    }

    /* ===== DB STATUS BANNER ===== */
    .db-status-bar {
        background: rgba(198, 156, 67, 0.12);
        border: 1px solid rgba(198, 156, 67, 0.3);
        border-radius: 10px;
        padding: 10px 18px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        font-size: 13px;
        color: #e5c986;
    }

    .db-status-bar a {
        color: #ffd875;
        font-weight: 600;
        text-decoration: underline;
        margin-left: 8px;
        white-space: nowrap;
    }

    /* ===== HERO SECTION ===== */
    .cinema-hero {
        position: relative;
        width: 100%;
        min-height: 480px;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 50px;
        background: #0d0a08;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
        border: 1px solid rgba(198, 156, 67, 0.2);
    }

    .cinema-hero-bg {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: 
            radial-gradient(ellipse at 70% 40%, rgba(138, 92, 36, 0.35) 0%, transparent 60%),
            radial-gradient(ellipse at 30% 60%, rgba(40, 20, 10, 0.9) 0%, #080605 80%);
        z-index: 1;
    }

    /* ภาพจำลองโรงภาพยนตร์คลาสสิก / โคมไฟระย้า */
    .cinema-hero-backdrop {
        position: absolute;
        top: 0; right: 0; bottom: 0;
        width: 60%;
        background: 
            linear-gradient(90deg, #080605 0%, rgba(8, 6, 5, 0.4) 40%, transparent 100%),
            radial-gradient(circle at 60% 40%, rgba(220, 160, 60, 0.2) 0%, transparent 60%);
        z-index: 1;
        opacity: 0.8;
    }

    .cinema-hero-bg-poster {
        position: absolute;
        top: 0; right: 0; bottom: 0;
        width: 60%;
        background-size: cover;
        background-position: center top;
        opacity: 0.28;
        filter: blur(4px);
        mask-image: linear-gradient(to right, transparent 0%, black 70%);
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 70%);
        z-index: 1;
    }

    .cinema-hero-flex {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 50px 60px;
        gap: 40px;
    }

    .cinema-hero-content {
        position: relative;
        z-index: 2;
        padding: 0;
        max-width: 650px;
    }

    .cinema-hero-poster-card {
        flex-shrink: 0;
        width: 250px;
        height: 360px;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 16px 45px rgba(0, 0, 0, 0.85), 0 0 30px rgba(198, 156, 67, 0.35);
        border: 2px solid rgba(198, 156, 67, 0.5);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .cinema-hero-poster-card:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 20px 55px rgba(0, 0, 0, 0.95), 0 0 40px rgba(223, 183, 108, 0.5);
    }

    .cinema-hero-poster-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .hero-tags {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        align-items: center;
    }

    .tag-imax {
        padding: 4px 10px;
        border: 1px solid rgba(198, 156, 67, 0.6);
        background: rgba(198, 156, 67, 0.15);
        color: #dfb76c;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .tag-age {
        padding: 4px 10px;
        background: rgba(180, 30, 30, 0.8);
        color: #fff;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    .hero-title {
        font-size: 42px;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.25;
        margin-bottom: 18px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.8);
    }

    .hero-title span {
        display: block;
    }

    .hero-desc {
        color: #a8a8b2;
        font-size: 13.5px;
        line-height: 1.8;
        margin-bottom: 28px;
        max-width: 520px;
        font-weight: 300;
    }

    .hero-actions {
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .btn-book-now {
        padding: 12px 30px;
        background: linear-gradient(135deg, #dfb76c 0%, #c69c43 100%);
        color: #120e06;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
        box-shadow: 0 4px 20px rgba(198, 156, 67, 0.35);
    }

    .btn-book-now:hover {
        background: linear-gradient(135deg, #eed08d 0%, #d4a74e 100%);
        transform: translateY(-2px);
        color: #000;
    }

    .btn-trailer {
        padding: 11px 24px;
        background: rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #e0e0e0;
        border-radius: 6px;
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
    }

    .btn-trailer:hover {
        border-color: #dfb76c;
        color: #dfb76c;
        background: rgba(198, 156, 67, 0.1);
    }

    /* ===== SECTION HEADERS ===== */
    .section-title-wrap {
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .section-title-main {
        font-size: 22px;
        font-weight: 600;
        color: #dfb76c;
        margin-bottom: 4px;
        letter-spacing: 0.3px;
    }

    .section-subtitle-main {
        font-size: 13px;
        color: #7d7d8c;
        font-weight: 300;
    }

    .section-see-all {
        color: #dfb76c;
        font-size: 13px;
        text-decoration: none;
        transition: opacity 0.2s;
    }

    .section-see-all:hover {
        opacity: 0.8;
        color: #ffd875;
    }

    /* ===== POPULAR MOVIES ROW (4 Cards) ===== */
    .popular-cards-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 60px;
    }

    .popular-card {
        background: #111118;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
        cursor: pointer;
    }

    .popular-card:hover {
        transform: translateY(-6px);
        border-color: rgba(223, 183, 108, 0.6);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7), 0 0 15px rgba(223, 183, 108, 0.2);
    }

    .popular-card:hover .popular-name {
        color: #dfb76c;
    }

    .popular-poster-wrap {
        width: 100%;
        aspect-ratio: 1 / 1.15;
        background: #181822;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .popular-poster-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1c1a24 0%, #101017 100%);
        color: rgba(198, 156, 67, 0.3);
        font-size: 40px;
    }

    .popular-poster-placeholder span {
        font-size: 11px;
        margin-top: 8px;
        color: #555566;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .popular-info {
        padding: 14px 16px 18px;
    }

    .popular-name {
        font-size: 15px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .popular-category {
        font-size: 12px;
        color: #7d7d8c;
        margin-bottom: 8px;
    }

    .popular-stars {
        display: flex;
        gap: 3px;
        color: #dfb76c;
        font-size: 11px;
    }

    .popular-stars .empty-star {
        color: #333344;
    }

    /* ===== NOW SHOWING SECTION (Grid of 3) ===== */
    .nowshowing-section {
        margin-bottom: 50px;
    }

    .nowshowing-cards-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .nowshowing-card {
        background: #111116;
        border-radius: 14px;
        padding: 18px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
        cursor: pointer;
    }

    .nowshowing-card:hover {
        transform: translateY(-6px);
        border-color: rgba(223, 183, 108, 0.6);
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.7), 0 0 18px rgba(223, 183, 108, 0.2);
    }

    .nowshowing-card:hover .card-movie-title {
        color: #dfb76c;
    }

    /* EXAMPLE PLACEHOLDER BOX (Red Rubber Stamp) */
    .example-stamp-box {
        width: 100%;
        aspect-ratio: 1 / 0.95;
        background: #ffffff;
        border-radius: 8px;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.1);
    }

    .example-stamp {
        border: 4px double #b82b2b;
        color: #b82b2b;
        padding: 10px 24px;
        font-size: 26px;
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        transform: rotate(-18deg);
        border-radius: 8px;
        opacity: 0.85;
        user-select: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 0 2px rgba(184, 43, 43, 0.3);
    }

    .example-stamp-sub {
        font-size: 9px;
        letter-spacing: 4px;
        margin-top: 2px;
        border-top: 1px solid #b82b2b;
        padding-top: 2px;
        width: 100%;
        text-align: center;
    }

    .card-movie-title {
        font-size: 16px;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 4px;
    }

    .card-movie-genre {
        font-size: 12px;
        color: #7d7d8c;
        margin-bottom: 12px;
    }

    .card-price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .card-price-value {
        color: #dfb76c;
        font-size: 15px;
        font-weight: 600;
    }

    .card-seats-badge {
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 12px;
        font-weight: 500;
    }

    .badge-seats-green {
        background: rgba(46, 160, 67, 0.15);
        color: #56d364;
        border: 1px solid rgba(46, 160, 67, 0.3);
    }

    .badge-seats-orange {
        background: rgba(210, 153, 34, 0.15);
        color: #e3b341;
        border: 1px solid rgba(210, 153, 34, 0.3);
    }

    .badge-seats-red {
        background: rgba(248, 81, 73, 0.15);
        color: #f85149;
        border: 1px solid rgba(248, 81, 73, 0.3);
    }

    .card-round-label {
        font-size: 11px;
        color: #7d7d8c;
        margin-bottom: 8px;
    }

    .card-round-chips {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .round-chip {
        padding: 5px 11px;
        background: #1a1a24;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        color: #cccccc;
        font-size: 12px;
        text-decoration: none;
        transition: all 0.2s;
    }

    .round-chip:hover {
        background: #dfb76c;
        color: #0b0b12;
        border-color: #dfb76c;
    }

    /* ===== PROMO DUAL BANNERS ===== */
    .promo-dual-wrap {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 60px;
    }

    .promo-banner-card {
        border-radius: 12px;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        overflow: hidden;
        position: relative;
    }

    .banner-theme-darkgold {
        background: linear-gradient(135deg, #1b160e 0%, #2b2010 40%, #15110a 100%);
        border: 1px solid rgba(198, 156, 67, 0.3);
    }

    .banner-theme-silky {
        background: linear-gradient(135deg, #33271a 0%, #4a3a28 50%, #261c12 100%);
        border: 1px solid rgba(223, 183, 108, 0.25);
    }

    .promo-banner-text h3 {
        font-size: 17px;
        font-weight: 600;
        color: #dfb76c;
        margin-bottom: 6px;
    }

    .promo-banner-text p {
        font-size: 12px;
        color: #9a9aa8;
        margin: 0;
        font-weight: 300;
    }

    .btn-promo-action {
        padding: 8px 18px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.3s;
        margin-left: 16px;
    }

    .btn-promo-action.filled {
        background: #dfb76c;
        color: #120e06;
    }

    .btn-promo-action.filled:hover {
        background: #eed08d;
        color: #000;
    }

    .btn-promo-action.outline {
        background: rgba(223, 183, 108, 0.1);
        border: 1px solid #dfb76c;
        color: #dfb76c;
    }

    .btn-promo-action.outline:hover {
        background: #dfb76c;
        color: #120e06;
    }

    /* ===== LUXURY FOOTER ===== */
    .cinema-luxury-footer {
        background: #08080c;
        border-top: 1px solid rgba(198, 156, 67, 0.15);
        margin: 0 -24px -40px;
        padding: 60px 0 30px;
    }

    .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .footer-columns {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.6fr;
        gap: 40px;
        margin-bottom: 40px;
    }

    .footer-logo-title {
        font-size: 18px;
        font-weight: 700;
        color: #dfb76c;
        letter-spacing: 1px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .footer-about-text {
        font-size: 12.5px;
        color: #7d7d8c;
        line-height: 1.8;
        font-weight: 300;
        margin-bottom: 20px;
    }

    .footer-social-row {
        display: flex;
        gap: 10px;
    }

    .footer-social-btn {
        width: 32px;
        height: 32px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #888899;
        font-size: 13px;
        text-decoration: none;
        transition: all 0.2s;
    }

    .footer-social-btn:hover {
        border-color: #dfb76c;
        color: #dfb76c;
    }

    .footer-group-title {
        font-size: 14px;
        font-weight: 600;
        color: #dfb76c;
        margin-bottom: 16px;
    }

    .footer-links-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .footer-links-list li {
        margin-bottom: 10px;
    }

    .footer-links-list a {
        color: #7d7d8c;
        font-size: 13px;
        text-decoration: none;
        transition: color 0.2s;
        font-weight: 300;
    }

    .footer-links-list a:hover {
        color: #dfb76c;
    }

    .footer-contact-info {
        font-size: 12.5px;
        color: #7d7d8c;
        line-height: 1.9;
        font-weight: 300;
    }

    .footer-contact-info a {
        color: #7d7d8c;
        text-decoration: none;
    }

    .footer-bottom-row {
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding-top: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: #555566;
    }

    .footer-luxury-tag {
        color: #8c6a23;
        font-size: 11px;
        letter-spacing: 1.5px;
        font-weight: 600;
    }

    @@media (max-width: 992px) {
        .cinema-hero-flex { padding: 40px 30px; }
        .cinema-hero-poster-card { width: 200px; height: 290px; }
        .popular-cards-grid { grid-template-columns: repeat(2, 1fr); }
        .nowshowing-cards-grid { grid-template-columns: repeat(2, 1fr); }
        .footer-columns { grid-template-columns: repeat(2, 1fr); }
        .hero-title { font-size: 32px; }
    }

    @@media (max-width: 768px) {
        .cinema-hero-flex { flex-direction: column-reverse; align-items: flex-start; padding: 30px 20px; }
        .cinema-hero-poster-card { width: 180px; height: 260px; margin-bottom: 10px; }
    }

    @@media (max-width: 600px) {
        .popular-cards-grid { grid-template-columns: 1fr; }
        .nowshowing-cards-grid { grid-template-columns: 1fr; }
        .promo-dual-wrap { grid-template-columns: 1fr; }
        .footer-columns { grid-template-columns: 1fr; }
        .hero-title { font-size: 26px; }
        .footer-bottom-row { flex-direction: column; gap: 8px; text-align: center; }
    }
</style>

<!-- ============================================== -->
<!-- 1. HERO BANNER: ตุ๊ดตู่กู้ชาติ / ซุส -->
<!-- ============================================== -->
@if (Model.FeaturedMovie != null)
{
    <section class="cinema-hero">
        <div class="cinema-hero-bg"></div>
        <div class="cinema-hero-backdrop"></div>
        @if (!string.IsNullOrEmpty(Model.FeaturedMovie.PosterUrl))
        {
            <div class="cinema-hero-bg-poster" style="background-image: url('@Model.FeaturedMovie.PosterUrl');"></div>
        }
        <div class="cinema-hero-flex">
            <div class="cinema-hero-content">
                <div class="hero-tags">
                    <span class="tag-imax">@(Model.FeaturedMovie.SpecialTag ?? "Super IMAX SPECIAL")</span>
                    <span class="tag-age">@(Model.FeaturedMovie.AgeRating ?? "ความรุนแรงระดับ 2000+")</span>
                </div>
                <h1 class="hero-title">
                    <a asp-controller="Home" asp-action="MovieDetail" asp-route-id="@Model.FeaturedMovie.MovieId" style="color:inherit; text-decoration:none;">
                        <span>@Model.FeaturedMovie.Title</span>
                    </a>
                </h1>
                <p class="hero-desc">
                    @Model.FeaturedMovie.Description
                </p>
                <div class="hero-actions">
                    <a asp-controller="Home" asp-action="MovieDetail" asp-route-id="@Model.FeaturedMovie.MovieId" class="btn-book-now">
                        <i class="fas fa-ticket-alt"></i> จองตั๋วเลย
                    </a>
                    <a href="#" class="btn-trailer">
                        <i class="far fa-play-circle"></i> ชมตัวอย่าง
                    </a>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.FeaturedMovie.PosterUrl))
            {
                <a asp-controller="Home" asp-action="MovieDetail" asp-route-id="@Model.FeaturedMovie.MovieId" class="cinema-hero-poster-card" style="display:block; text-decoration:none;">
                    <img src="@Model.FeaturedMovie.PosterUrl" alt="@Model.FeaturedMovie.Title" class="cinema-hero-poster-img" />
                </a>
            }
        </div>
    </section>
}

<!-- ============================================== -->
<!-- 2. หนังยอดนิยม (4 Cards) -->
<!-- ============================================== -->
<section>
    <div class="section-title-wrap">
        <div>
            <h2 class="section-title-main">หนังยอดนิยม</h2>
            <div class="section-subtitle-main">ภาพยนตร์กระแสแรงที่มีผู้เข้าชมสูงสุดในสัปดาห์นี้</div>
        </div>
        <a asp-action="NowShowing" class="section-see-all">
            ดูทั้งหมด <i class="fas fa-chevron-right" style="font-size:11px;"></i>
        </a>
    </div>

    <div class="popular-cards-grid">
        @foreach (var movie in Model.PopularMovies)
        {
            <a asp-controller="Home" asp-action="MovieDetail" asp-route-id="@movie.MovieId" class="popular-card" style="text-decoration:none; color:inherit; display:block;">
                <div class="popular-poster-wrap">
                    @if (!string.IsNullOrEmpty(movie.PosterUrl))
                    {
                        <img src="@movie.PosterUrl" alt="@movie.Title" style="width:100%; height:100%; object-fit:cover;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="popular-poster-placeholder" style="display:none;">
                            <i class="fas fa-film"></i>
                            <span>Movie Poster</span>
                        </div>
                    }
                    else
                    {
                        <div class="popular-poster-placeholder">
                            <i class="fas fa-film"></i>
                            <span>Movie Poster</span>
                        </div>
                    }
                </div>
                <div class="popular-info">
                    <div class="popular-name" title="@movie.Title">@movie.Title</div>
                    <div class="popular-category">@movie.Genre</div>
                    <div class="popular-stars">
                        @{
                            int starCount = (int)Math.Round(movie.Rating / 2);
                            for (int i = 0; i < 5; i++)
                            {
                                if (i < starCount)
                                {
                                    <i class="fas fa-star"></i>
                                }
                                else
                                {
                                    <i class="fas fa-star empty-star"></i>
                                }
                            }
                        }
                    </div>
                </div>
            </a>
        }
    </div>
</section>

<!-- ============================================== -->
<!-- 3. กำลังฉายอยู่ตอนนี้ (Cards with Posters / Stamp) -->
<!-- ============================================== -->
<section class="nowshowing-section" id="nowshowing">
    <div class="section-title-wrap">
        <div>
            <h2 class="section-title-main">กำลังฉายอยู่ตอนนี้</h2>
            <div class="section-subtitle-main">เลือกรอบฉายและจองที่นั่งที่ดีที่สุดของคุณได้ทันที</div>
        </div>
    </div>

    <div class="nowshowing-cards-grid">
        @foreach (var item in Model.NowShowingMovies)
        {
            <a asp-controller="Home" asp-action="MovieDetail" asp-route-id="@item.MovieId" class="nowshowing-card" style="text-decoration:none; color:inherit; display:block;">
                <!-- กรอบรูปโปสเตอร์ภาพยนตร์ หรือตรา EXAMPLE -->
                <div class="example-stamp-box" style="@(!string.IsNullOrEmpty(item.PosterUrl) ? "background:#181822; padding:0; overflow:hidden; border:none;" : "")">
                    @if (!string.IsNullOrEmpty(item.PosterUrl))
                    {
                        <img src="@item.PosterUrl" alt="@item.Title" style="width:100%; height:100%; object-fit:cover; display:block;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                        <div class="example-stamp" style="display:none;">
                            EXAMPLE
                            <div class="example-stamp-sub">CINEMA</div>
                        </div>
                    }
                    else
                    {
                        <div class="example-stamp">
                            EXAMPLE
                            <div class="example-stamp-sub">CINEMA</div>
                        </div>
                    }
                </div>

                <div class="card-movie-title">@item.Title</div>
                <div class="card-movie-genre">@item.Genre</div>

                <div class="card-price-row">
                    <div class="card-price-value">
                        @item.PriceMin.ToString("0") - @item.PriceMax.ToString("0")
                    </div>
                    @if (item.SeatsRemaining <= 10)
                    {
                        <span class="card-seats-badge badge-seats-red">เหลือ @item.SeatsRemaining ที่นั่ง</span>
                    }
                    else if (item.SeatsRemaining <= 30)
                    {
                        <span class="card-seats-badge badge-seats-orange">เหลือ @item.SeatsRemaining ที่นั่ง</span>
                    }
                    else
                    {
                        <span class="card-seats-badge badge-seats-green">เหลือ @item.SeatsRemaining ที่นั่ง</span>
                    }
                </div>

                <div class="card-round-label">รอบวันนี้</div>
                <div class="card-round-chips">
                    @foreach (var time in item.Showtimes)
                    {
                        <span class="round-chip">@time</span>
                    }
                </div>
            </a>
        }
    </div>
</section>

