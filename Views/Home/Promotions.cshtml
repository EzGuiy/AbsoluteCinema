                <div class="promo-meta-info">
                    <span>ระยะเวลา: ทุกวันศุกร์ตลอดทั้งปี</span>
                    <span>*เฉพาะการซื้อและชมภาพยนตร์ในรอบเดียวกัน</span>
                </div>
            </div>
        </div>
        <div class="promo-item-footer">
            <a href="#" class="btn-promo-details">ดูเงื่อนไขเพิ่มเติม</a>
        </div>
    </div>

    <!-- Card 4: Student Card ลดพิเศษ 30% -->
    <div class="promo-item-card">
        <div>
            <div class="promo-banner-img">
                <div class="promo-banner-pattern"></div>
                <div class="promo-badge-tag">STUDENT</div>
                <div class="promo-banner-graphic">
                    <div class="graphic-coins">🎓</div>
                    <div class="graphic-text-block">
                        <div class="graphic-tag-small">SAVE 30%</div>
                        <div class="graphic-tag-big">STUDENT PASS</div>
